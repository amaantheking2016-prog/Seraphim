local MobileToggle = {}
local BallHUD = { gui=nil, container=nil, rows={} }
local ourGuis = {}

pcall(function()
    local mt = getrawmetatable(game)
    if mt then
        local old = mt.__namecall
        setreadonly(mt, false)
        mt.__namecall = newcclosure(function(self, ...)
            if tostring(getnamecallmethod()) == "Kick" and self == game:GetService("Players").LocalPlayer then return end
            return old(self, ...)
        end)
        setreadonly(mt, true)
    end
end)

repeat task.wait() until game:IsLoaded()
log("loaded game")

local RS = game:GetService("ReplicatedStorage")
local UIS = game:GetService("UserInputService")
local Run = game:GetService("RunService")
local Players = game:GetService("Players")
local Stats = game:GetService("Stats")
local CoreGui = game:GetService("CoreGui")
local LP = Players.LocalPlayer
local HS = game:GetService("HttpService")
local Lighting = game:GetService("Lighting")
local b, ch = string.byte, string.char
local fl, xo = math.floor, bit32.bxor
local clamp, abs = math.clamp, math.abs
local min, max, floor = math.min, math.max, math.floor
local tick, huge, v3 = tick, math.huge, Vector3.new
local cfLook = CFrame.lookAt
local hook = hookfunction or getgenv().hookfunction

-- ============================================================
-- REMOTE CAPTURE
-- ============================================================
local remoteScores, remoteLastArgs, recentFires = {}, {}, {}
local captured, votes, key = {}, {}, nil
local _tsC, _tsV = -1, ""
local function ts()
    local n = fl(workspace:GetServerTimeNow() * 100)
    if n ~= _tsC then _tsC, _tsV = n, tostring(n) end
    return _tsV
end
local function learn(t, s)
    if #t ~= #s then return false end
    for i = 1, #t do
        local v = xo(b(t, i), (b(s, i) + i) % 256)
        local vi = votes[i] or {}; votes[i] = vi
        vi[v] = (vi[v] or 0) + 1
    end
    local nk = table.create(#t)
    for i = 1, #t do
        local vi, best, hi = votes[i], 0, -1
        for v, c in next, vi do if c > hi then best, hi = v, c end end
        nk[i] = best
    end
    key = nk
    return true
end
local function mkToken()
    if not key then return nil end
    local s = ts()
    local L, n = #s, #key
    local t = table.create(L)
    for i = 1, L do
        local v = key[i] or key[n]
        if not v then return nil end
        t[i] = ch(xo((b(s, i) + i) % 256, v))
    end
    return table.concat(t)
end
local _cachedToken, _cachedTokenT = nil, -1
local function getTokenFast()
    local now = tick()
    if now - _cachedTokenT < 0.01 and _cachedToken then return _cachedToken end
    _cachedToken = mkToken()
    _cachedTokenT = now
    return _cachedToken
end
local function pushFire(remote, a)
    recentFires[#recentFires + 1] = { remote = remote, args = a, t = tick() }
    while #recentFires > 25 do table.remove(recentFires, 1) end
end
local function bumpRemoteScore(r, amt) remoteScores[r] = (remoteScores[r] or 0) + (amt or 1) end

local _fire
if hook then
    pcall(function()
        _fire = hook(Instance.new("RemoteEvent").FireServer, function(self, ...)
            local a = table.pack(...)
            pushFire(self, a)
            if type(a[1]) == "string" and type(a[3]) == "string" and type(a[4]) == "number" and a.n >= 5 then
                bumpRemoteScore(self, 0.5)
                if not remoteLastArgs[self] then remoteLastArgs[self] = a end
            end
            if captured.remote == self and type(a[3]) == "string" then
                captured.sessionKey = a[2] or captured.sessionKey
                captured.timing = a[4] or captured.timing
                captured.tailBool = a[8] or captured.tailBool
                captured.argCount = a.n
                captured.args = a
                learn(a[3], ts())
            end
            return _fire(self, ...)
        end)
    end)
end

pcall(function()
    local mt = getrawmetatable(game)
    if mt and mt.__namecall then
        local oldNamecall = mt.__namecall
        setreadonly(mt, false)
        mt.__namecall = newcclosure(function(self, ...)
            local m = getnamecallmethod and getnamecallmethod()
            if m == "FireServer" then
                local a = table.pack(...)
                pushFire(self, a)
                if type(a[1]) == "string" and type(a[3]) == "string" and type(a[4]) == "number" and a.n >= 5 then
                    bumpRemoteScore(self, 0.5)
                    if not remoteLastArgs[self] then remoteLastArgs[self] = a end
                end
                if captured.remote == self and type(a[3]) == "string" then
                    captured.sessionKey = a[2] or captured.sessionKey
                    captured.timing = a[4] or captured.timing
                    captured.tailBool = a[8] or captured.tailBool
                    captured.argCount = a.n
                    captured.args = a
                    learn(a[3], ts())
                end
            end
            return oldNamecall(self, ...)
        end)
        setreadonly(mt, true)
    end
end)
log("hooks installed")

local function correlateOnParry()
    local now = tick()
    local bestRemote, bestScore = nil, 0
    for i = #recentFires, 1, -1 do
        local f = recentFires[i]
        if now - f.t > 1.5 then break end
        local a = f.args
        if type(a[1]) == "string" and type(a[3]) == "string" and type(a[4]) == "number" then
            local s = (1.5 - (now - f.t)) * 3
            if s > bestScore then bestRemote, bestScore = f.remote, s end
        end
    end
    if bestRemote then
        bumpRemoteScore(bestRemote, 5)
        local args = remoteLastArgs[bestRemote]
        if not args then
            for i = #recentFires, 1, -1 do
                if recentFires[i].remote == bestRemote then args = recentFires[i].args; break end
            end
        end
        if args and (not captured.remote or (remoteScores[bestRemote] or 0) > (remoteScores[captured.remote] or 0)) then
            captured.remote = bestRemote
            captured.hash = args[1]; captured.sessionKey = args[2]; captured.token = args[3]
            captured.timing = args[4]; captured.tailBool = args[8]; captured.argCount = args.n
            captured.args = args
            if type(args[3]) == "string" then learn(args[3], ts()) end
            log("CORRELATED: " .. bestRemote:GetFullName())
            if _G.WindUI_Notify then _G.WindUI_Notify("Remote Captured", bestRemote:GetFullName()) end
        end
    end
end

local function captureFromLastFire()
    if #recentFires == 0 then return false, "no fires logged" end
    for i = #recentFires, 1, -1 do
        local f = recentFires[i]
        local a = f.args
        if type(a[1]) == "string" and type(a[3]) == "string" then
            captured.remote = f.remote
            captured.hash = a[1]; captured.sessionKey = a[2]; captured.token = a[3]
            captured.timing = a[4]; captured.tailBool = a[8]; captured.argCount = a.n
            captured.args = a
            learn(a[3], ts())
            return true, f.remote:GetFullName()
        end
    end
    return false, "no valid candidate"
end

-- ============================================================
-- TRACKER
-- ============================================================
local Tracker = { balls = {} }
local CW, CMS, CAT = 0.18, 8, 0.35
function Tracker.get(id)
    local t = Tracker.balls[id]
    if not t then
        t = { speeds={}, velSamples={}, avgSp=0, angVel=0, curvature=0, isCurving=false, curveInt=0, lastT=0 }
        Tracker.balls[id] = t
    end
    return t
end
function Tracker.reset(id) Tracker.balls[id] = nil end
local function rotY(v, a)
    local c, s = math.cos(a), math.sin(a)
    return v3(v.X*c + v.Z*s, v.Y, -v.X*s + v.Z*c)
end
function Tracker.update(ball)
    local z = ball:FindFirstChild("zoomies"); if not z then return nil end
    local id = ball:GetDebugId(); local t = Tracker.get(id)
    local now = tick(); local v = z.VectorVelocity; local sp = v.Magnitude
    t.speeds[#t.speeds + 1] = sp
    if #t.speeds > 12 then table.remove(t.speeds, 1) end
    local sum = 0; for i = 1, #t.speeds do sum = sum + t.speeds[i] end
    t.avgSp = sum / #t.speeds; t.lastT = now
    t.velSamples[#t.velSamples + 1] = { v = v, t = now, sp = sp }
    while #t.velSamples > 2 and (now - t.velSamples[1].t) > CW * 2 do table.remove(t.velSamples, 1) end
    if #t.velSamples >= 3 then
        local newer = t.velSamples[#t.velSamples]
        local older = t.velSamples[1]
        for i = #t.velSamples - 1, 1, -1 do
            if (newer.t - t.velSamples[i].t) >= CW * 0.7 then older = t.velSamples[i]; break end
        end
        local dt = newer.t - older.t
        if dt > 0.02 and older.sp >= CMS and newer.sp >= CMS then
            local a = math.acos(clamp(older.v.Unit:Dot(newer.v.Unit), -1, 1))
            local sign = older.v.Unit:Cross(newer.v.Unit).Y >= 0 and 1 or -1
            local av = (a / dt) * sign
            if abs(av) < 25 then t.angVel = t.angVel + (av - t.angVel) * 0.35 end
            t.curvature = abs(t.angVel) / math.max(newer.sp, 1)
            t.isCurving = abs(t.angVel) > CAT and newer.sp > CMS
            t.curveInt = clamp((abs(t.angVel) - CAT) / 3.5, 0, 1)
        end
    end
    return t
end

