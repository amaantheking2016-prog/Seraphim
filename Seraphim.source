-- CONFIG
-- ============================================================
local cfg = {
    ap=false, ms=false, spf=4, acc=65, spam_speed=3, turbo=false,
    walkSpeed=16, jumpPower=50, antiAfk=false, autoRejoin=false,
    curveAware=true, fps=true, fullbright=false, noFog=false,   -- FIXED: fullbright + noFog now in config
    spamKey="P", toggleX=nil, toggleY=nil, uiHidden=false,
    ballHUD=true, adaptiveAcc=true,
}
local CFG_PATH = "seraphim_cfg.json"
local function saveCfg() pcall(function() if writefile then writefile(CFG_PATH, HS:JSONEncode(cfg)) end end) end
pcall(function()
    if isfile and isfile(CFG_PATH) then
        for k, v in pairs(HS:JSONDecode(readfile(CFG_PATH))) do cfg[k] = v end
    end
end)

local AccPts = {
    {65, 0.8307070707070668}, {80, 1.0254040404040357}, {90, 1.1552020202020148},
    {100, 1.284999999999994}, {140, 1.8}, {200, 2.582979797979786},
}
local function accValue(v)
    v = clamp(v, 1, 200)
    if v <= AccPts[1][1] then return AccPts[1][2] end
    if v >= AccPts[#AccPts][1] then return AccPts[#AccPts][2] end
    for i = 1, #AccPts - 1 do
        local a, b_ = AccPts[i], AccPts[i+1]
        if v >= a[1] and v <= b_[1] then
            return a[2] + (b_[2] - a[2]) * ((v - a[1]) / (b_[1] - a[1]))
        end
    end
    return AccPts[1][2]
end
local curAcc = accValue(cfg.acc)
local baseAcc = curAcc

-- ============================================================
-- STATS + PING
-- ============================================================
local S = { parries=0, attempts=0, sessionStart=tick(), pps={}, misses=0 }
local function bumpParry()
    S.parries = S.parries + 1
    S.pps[#S.pps + 1] = tick()
    while #S.pps > 0 and tick() - S.pps[1] > 60 do table.remove(S.pps, 1) end
end
local function parryRate() return #S.pps end
local _pingEMA, _pingSamples = 0, 0
local function getPing()
    local ok, p = pcall(function() return Stats.Network.ServerStatsItem["Data Ping"]:GetValue() end)
    if not ok or not p then return 60 end
    if _pingSamples == 0 then _pingEMA = p
    else _pingEMA = _pingEMA + (p - _pingEMA) * 0.25 end
    _pingSamples = _pingSamples + 1
    return _pingEMA
end

-- ============================================================
-- BALLS
-- ============================================================
local _ballCache, _ballDirty = {}, true
local function markDirty() _ballDirty = true end
do
    local bf = workspace:FindFirstChild("Balls")
    if bf then bf.ChildAdded:Connect(markDirty); bf.ChildRemoved:Connect(markDirty) end
end
local function getBalls()
    if _ballDirty then
        _ballDirty = false
        local bf = workspace:FindFirstChild("Balls")
        if not bf then _ballCache = {}; return _ballCache end
        local t = {}
        for _, x in ipairs(bf:GetChildren()) do
            if x:GetAttribute("realBall") then t[#t+1] = x end
        end
        _ballCache = t
    end
    return _ballCache
end

-- ============================================================
-- FIRING
-- ============================================================
local firedBalls, lastFirePerBall = {}, {}
local lastSuccessTime, lastSpamFire = 0, 0
local _lastCF, _lastCFT = nil, -1
local function computeCF()
    local now = tick()
    if _lastCF and now - _lastCFT < 0.02 then return _lastCF end
    _lastCFT = now
    local cam = workspace.CurrentCamera
    local c = LP.Character; local h = c and c.PrimaryPart
    if not h then _lastCF = cam.CFrame; return _lastCF end
    local mp = UIS:GetMouseLocation()
    local ray = cam:ViewportPointToRay(mp.X, mp.Y)
    local closest, cd = nil, huge
    local alive = workspace:FindFirstChild("Alive")
    if alive then
        for _, x in ipairs(alive:GetChildren()) do
            if x ~= c then
                local pp = x.PrimaryPart
                if pp then
                    local delta = pp.Position - cam.CFrame.Position
                    if delta.Unit:Dot(ray.Direction) > 0.5 then
                        local m = delta.Magnitude
                        if m < cd then cd = m; closest = x end
                    end
                end
            end
        end
    end
    local tp = (closest and closest.PrimaryPart) and closest.PrimaryPart.Position
        or (h.Position + cam.CFrame.LookVector * 1000)
    _lastCF = cfLook(h.Position, tp + v3(0, 1.75, 0))
    return _lastCF
end
local _spCache, _spCacheT = {}, -1
local function buildScreenPoints(cam)
    local now = tick()
    if now - _spCacheT < 0.03 then return _spCache end
    _spCacheT = now
    local sp = {}
    local alive = workspace:FindFirstChild("Alive")
    if alive then
        for _, x in ipairs(alive:GetChildren()) do
            local pp = x.PrimaryPart
            if pp then
                local ok, pt = pcall(cam.WorldToScreenPoint, cam, pp.Position)
                if ok then sp[x.Name] = pt end
            end
        end
    end
    _spCache = sp
    return sp
end

local function fireNoYield(n)
    if not _fire then return end
    local rem, sk = captured.remote, captured.sessionKey
    if not rem or not sk then return end
    local token = getTokenFast(); if not token then return end
    local cam = workspace.CurrentCamera
    local sp = buildScreenPoints(cam)
    local mp = UIS:GetMouseLocation()
    local cf = computeCF()
    local ms = { mp.X, mp.Y }
    local tail = captured.tailBool or false
    local timing = captured.timing or 0.5
    S.attempts = S.attempts + n
    pcall(function()
        for i = 1, n do
            if captured.hash then
                _fire(rem, captured.hash, sk, token, timing, cf, sp, ms, tail)
            else
                _fire(rem, sk, token, timing, cf, sp, ms, tail)
            end
        end
    end)
end

-- ============================================================
-- AUTO PARRY
-- ============================================================
local apConn = nil
local function startAP()
    if apConn then apConn:Disconnect() end
    apConn = Run.PreSimulation:Connect(function()
        if not cfg.ap then return end
        local c = LP.Character; if not c or not c.PrimaryPart then return end
        local hrp = c.PrimaryPart
        local now = tick()
        local pingBase = clamp(getPing() / 10, 4, 15)
        local myName = LP.Name
        local hrpPos = hrp.Position

        for id, fireTime in pairs(lastFirePerBall) do
            if now - fireTime > 0.8 then
                firedBalls[id] = nil; lastFirePerBall[id] = nil
            end
        end
        for _, ball in ipairs(getBalls()) do
            local id = ball:GetDebugId()
            if firedBalls[id] then
                local tgt = ball:GetAttribute("target")
                if tgt ~= myName then
                    firedBalls[id] = nil; lastFirePerBall[id] = nil
                else
                    local z = ball:FindFirstChild("zoomies")
                    if z then
                        local v = z.VectorVelocity
                        local toBall = ball.Position - hrpPos
                        if toBall.Magnitude > 0.5 and v.Unit:Dot(toBall.Unit) < -0.15 then
                            firedBalls[id] = nil; lastFirePerBall[id] = nil
                        end
                    end
                end
            end
        end

        local threats = {}
        for _, ball in ipairs(getBalls()) do
            local id = ball:GetDebugId()
            if firedBalls[id] then continue end
            local lf = lastFirePerBall[id]
            if lf and (now - lf) < 0.02 then continue end
            if ball:GetAttribute("target") ~= myName then continue end
            local z = ball:FindFirstChild("zoomies"); if not z then continue end
            local t = Tracker.update(ball); if not t then continue end
            local v = z.VectorVelocity
            local sp = t.avgSp > 3 and t.avgSp or v.Magnitude
            if sp < 3 then continue end
            local delta = hrpPos - ball.Position
            local dist = delta.Magnitude
            local dot = v.Unit:Dot(delta.Unit)
            if dot <= 0.05 then continue end
            local eta = dist / (sp * dot)
            local threat = (1 / math.max(eta, 0.05)) * (1 + (t.curveInt or 0) * 0.5)
            threats[#threats + 1] = { id=id, eta=eta, dist=dist, sp=sp, t=t, threat=threat }
        end
        if #threats == 0 then return end
        table.sort(threats, function(a, b_) return a.threat > b_.threat end)

        local fireCount = math.min(#threats, 2)
        for i = 1, fireCount do
            local th = threats[i]
            local avgSp = th.t.avgSp > 3 and th.t.avgSp or th.sp
            local speedAdj = min(max(avgSp - 9.5, 0), 700)
            local scaledAg = (2.6 + speedAdj * 0.0025) * curAcc
            local targetDist = pingBase + max(avgSp / scaledAg, 8.5)
            local isC = th.t.isCurving
            local cur = th.t.curveInt or 0
            local shots = 4
            if isC then
                targetDist = targetDist * (1.15 + cur * 0.45)
                shots = 6 + floor(cur * 6)
            else
                if avgSp > 150 then shots = 5 end
                if avgSp > 220 then shots = 6 end
                if avgSp > 300 then shots = 8 end
            end
            if cfg.spf == 8 then shots = shots + 2 end
            if i > 1 then shots = math.max(3, floor(shots / 2)) end
            if th.dist <= targetDist then
                fireNoYield(shots)
                firedBalls[th.id] = true
                lastFirePerBall[th.id] = now
            end
        end
    end)
end
local function stopAP()
    if apConn then apConn:Disconnect(); apConn = nil end
    firedBalls = {}; lastFirePerBall = {}; Tracker.balls = {}
end

pcall(function()
    RS.Remotes.ParrySuccess.OnClientEvent:Connect(function()
        lastSuccessTime = tick(); bumpParry(); correlateOnParry()
        for id in pairs(firedBalls) do firedBalls[id] = nil end
        lastFirePerBall = {}
    end)
end)

-- ============================================================
-- SMART SPAM
-- ============================================================
local msConn = nil
local function startMS()
    if msConn then msConn:Disconnect() end
    lastSpamFire = 0
    msConn = Run.PreSimulation:Connect(function()
        if not cfg.ms then return end
        local c = LP.Character; local h = c and c.PrimaryPart; if not h then return end
        if cfg.turbo then fireNoYield(max(cfg.spf, 4)); return end
        local hp = h.Position
        local nearest = huge
        for _, ball in ipairs(getBalls()) do
            local d = (hp - ball.Position).Magnitude
            if d < nearest then nearest = d end
        end
        if nearest > 80 then return end
        local baseGap = cfg.spam_speed / 1000
        local gap = nearest < 25 and baseGap * 0.6 or (nearest < 45 and baseGap * 0.85 or baseGap)
        local now = tick()
        if now - lastSpamFire < gap then return end
        lastSpamFire = now
        local burst = cfg.spf
        if nearest < 20 then burst = burst + 2 end
        fireNoYield(burst)
    end)
end
local function stopMS()
    if msConn then msConn:Disconnect(); msConn = nil end
    lastSpamFire = 0
end

-- ============================================================
-- BALL HUD
-- ============================================================
local function destroyBallHUD()
    if BallHUD.gui then BallHUD.gui:Destroy() end
    BallHUD.gui = nil; BallHUD.container = nil; BallHUD.rows = {}
end
local function buildBallHUD()
    if BallHUD.gui then return end
    local par = CoreGui
    pcall(function() if gethui then par = gethui() end end)
    local sg = Instance.new("ScreenGui", par)
    sg.Name = "SeraphimBallHUD"; sg.ResetOnSpawn = false
    sg.IgnoreGuiInset = true; sg.DisplayOrder = 3500
    BallHUD.gui = sg
    local fr = Instance.new("Frame", sg)
    fr.Size = UDim2.fromOffset(220, 40)
    fr.Position = UDim2.new(1, -228, 0, 40)
    fr.BackgroundColor3 = Color3.fromRGB(14, 14, 20)
    fr.BackgroundTransparency = 0.2; fr.BorderSizePixel = 0
    BallHUD.container = fr
    Instance.new("UICorner", fr).CornerRadius = UDim.new(0, 8)
    local stroke = Instance.new("UIStroke", fr)
    stroke.Color = Color3.fromRGB(139, 92, 246); stroke.Thickness = 1; stroke.Transparency = 0.4
    local title = Instance.new("TextLabel", fr)
    title.Size = UDim2.new(1, -10, 0, 18); title.Position = UDim2.new(0, 5, 0, 2)
    title.BackgroundTransparency = 1; title.Text = "BALLS"
    title.Font = Enum.Font.GothamBold; title.TextSize = 10
    title.TextColor3 = Color3.fromRGB(180, 150, 240)
    title.TextXAlignment = Enum.TextXAlignment.Left
    local rowsFrame = Instance.new("Frame", fr)
    rowsFrame.Size = UDim2.new(1, -8, 1, -22); rowsFrame.Position = UDim2.new(0, 4, 0, 20)
    rowsFrame.BackgroundTransparency = 1
    BallHUD.rowsFrame = rowsFrame
    local layout = Instance.new("UIListLayout", rowsFrame)
    layout.Padding = UDim.new(0, 2); layout.SortOrder = Enum.SortOrder.LayoutOrder
end

task.spawn(function()
    while _G.sera do
        task.wait(0.1)
        if cfg.ballHUD then
            if not BallHUD.gui then buildBallHUD() end
            local myPos = LP.Character and LP.Character.PrimaryPart and LP.Character.PrimaryPart.Position
            local myName = LP.Name
            local active = {}
            for _, ball in ipairs(getBalls()) do
                if ball:GetAttribute("target") == myName then
                    local z = ball:FindFirstChild("zoomies")
                    if z then
                        local t = Tracker.get(ball:GetDebugId())
                        local sp = t.avgSp or 0
                        local dist = myPos and (ball.Position - myPos).Magnitude or 0
                        active[#active + 1] = { sp = sp, dist = dist, t = t }
                    end
                end
            end
            if BallHUD.container then
                BallHUD.container.Size = UDim2.fromOffset(220, 24 + math.max(1, #active) * 14)
            end
            for i = 1, math.max(#active, #(BallHUD.rows or {})) do
                if not BallHUD.rows[i] and BallHUD.rowsFrame then
                    local l = Instance.new("TextLabel", BallHUD.rowsFrame)
                    l.Size = UDim2.new(1, 0, 0, 12); l.BackgroundTransparency = 1
                    l.Font = Enum.Font.Code; l.TextSize = 10
                    l.TextColor3 = Color3.fromRGB(220, 220, 240)
                    l.TextXAlignment = Enum.TextXAlignment.Left
                    l.LayoutOrder = i
                    BallHUD.rows[i] = l
                end
                local r = BallHUD.rows[i]
                if r then
                    if i <= #active then
                        local a = active[i]
                        local cm = a.t.isCurving and ("*%.2f"):format(a.t.curveInt) or ""
                        r.Text = ("#%d  %.0fsps  %.0fm %s"):format(i, a.sp, a.dist, cm)
                        r.TextColor3 = a.t.isCurving and Color3.fromRGB(255, 180, 80) or Color3.fromRGB(200, 220, 255)
                        r.Visible = true
                    else r.Visible = false end
                end
            end
        else
            if BallHUD.gui then destroyBallHUD() end
        end
    end
end)

-- ============================================================
-- MOBILE TOGGLE
-- ============================================================
local function createMobileToggle()
    if MobileToggle.gui then return end
    local par = CoreGui
    pcall(function() if gethui then par = gethui() end end)
    local sg = Instance.new("ScreenGui", par)
    sg.Name = "SeraphimMobileToggle"; sg.ResetOnSpawn = false
    sg.IgnoreGuiInset = true; sg.DisplayOrder = 10000
    MobileToggle.gui = sg
    local BTN = 52
    local fr = Instance.new("Frame", sg)
    fr.Size = UDim2.fromOffset(BTN, BTN)
    local cam = workspace.CurrentCamera
    local vp = cam and cam.ViewportSize or Vector2.new(400, 800)
    local ix = clamp(cfg.toggleX or 20, 0, max(0, vp.X - BTN))
    local iy = clamp(cfg.toggleY or floor(vp.Y * 0.7), 0, max(0, vp.Y - BTN))
    fr.Position = UDim2.fromOffset(ix, iy)
    fr.BackgroundColor3 = Color3.fromRGB(139, 92, 246)
    fr.BackgroundTransparency = 0.2; fr.BorderSizePixel = 0; fr.Active = true
    MobileToggle.frame = fr
    Instance.new("UICorner", fr).CornerRadius = UDim.new(0, 26)
    local stroke = Instance.new("UIStroke", fr)
    stroke.Color = Color3.fromRGB(220, 220, 240); stroke.Thickness = 2; stroke.Transparency = 0.3
    local lbl = Instance.new("TextLabel", fr)
    lbl.Size = UDim2.new(1, 0, 1, 0); lbl.BackgroundTransparency = 1
    lbl.Text = "UI"; lbl.Font = Enum.Font.GothamBold
    lbl.TextSize = 18; lbl.TextColor3 = Color3.new(1,1,1)
    local dI, sT, sX, sY, moved = nil, nil, 0, 0, false
    fr.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then
            dI, sT = i, i.Position; sX, sY = fr.Position.X.Offset, fr.Position.Y.Offset; moved = false
        end
    end)
    UIS.InputChanged:Connect(function(i)
        if dI ~= i then return end
        if i.UserInputType ~= Enum.UserInputType.Touch and i.UserInputType ~= Enum.UserInputType.MouseMovement then return end
        local dx = i.Position.X - sT.X
        local dy = i.Position.Y - sT.Y
        if abs(dx) > 8 or abs(dy) > 8 then moved = true end
        local vp2 = (workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize) or Vector2.new(400, 800)
        fr.Position = UDim2.fromOffset(clamp(sX+dx, 0, max(0, vp2.X-BTN)), clamp(sY+dy, 0, max(0, vp2.Y-BTN)))
    end)
    UIS.InputEnded:Connect(function(i)
        if dI == i then
            dI = nil
            if moved then cfg.toggleX, cfg.toggleY = fr.Position.X.Offset, fr.Position.Y.Offset; saveCfg()
            else if toggleUI then toggleUI() end end
        end
    end)
end

-- ============================================================
-- LOAD WINDUI (with fallback)
-- ============================================================
log("loading WindUI...")
local WindUIOK, WindUI = false, nil
local WINDUI_URLS = {
    "https://github.com/Footagesus/WindUI/releases/latest/download/main.lua",
    "https://raw.githubusercontent.com/Footagesus/WindUI/main/dist/main.lua",
    "https://raw.githubusercontent.com/Footagesus/WindUI/refs/heads/main/main_example.lua",
}
for i, url in ipairs(WINDUI_URLS) do
    if WindUIOK then break end
    pcall(function()
        local src = game:HttpGet(url)
        if not src or #src < 500 then error("bad source (" .. tostring(src and #src) .. ")") end
        local fn = loadstring(src)
        if not fn then error("loadstring nil") end
        WindUI = fn()
        if type(WindUI) ~= "table" and type(WindUI) ~= "userdata" then error("not table: " .. type(WindUI)) end
        WindUIOK = true
        log("WindUI loaded from URL #" .. i)
    end)
end
if not WindUIOK then warn("[Seraphim] All WindUI URLs failed — using fallback UI") end

_G.WindUI_Notify = function(title, content)
    if WindUI then pcall(function() WindUI:Notify({ Title = title, Content = content }) end) end
end

-- ============================================================
-- toggleUI (now with proper forward-decl)
-- ============================================================
function toggleUI()
    cfg.uiHidden = not cfg.uiHidden; saveCfg()
    for _, sg in ipairs(ourGuis) do pcall(function() sg.Enabled = not cfg.uiHidden end) end
    pcall(function()
        local search = {}
        pcall(function() for _, g in ipairs(CoreGui:GetChildren()) do if g:IsA("ScreenGui") then search[#search+1] = g end end end)
        pcall(function() if gethui then for _, g in ipairs(gethui():GetChildren()) do if g:IsA("ScreenGui") then search[#search+1] = g end end end)
        for _, g in ipairs(search) do
            if g ~= MobileToggle.gui and g ~= BallHUD.gui and g ~= _G.sera_fallback then
                local nm = g.Name:lower()
                if nm:find("wind") or nm:find("seraphim") then g.Enabled = not cfg.uiHidden end
            end
        end
    end)
    if not cfg.uiHidden then _G.WindUI_Notify("UI", "Shown") end
end

-- ============================================================
-- BUILD UI (WindUI or fallback)
-- ============================================================
local Window = nil
if WindUIOK then
    pcall(function()
        Window = WindUI:CreateWindow({
            Title = "Seraphim",
            Author = "v21",
            Icon = "solar:shield-bold",
            Folder = "Seraphim",
            NewElements = true,
            Size = UDim2.fromOffset(560, 440),
            Topbar = { Height = 44, ButtonsType = "Mac" },
        })
    end)
    log("window: " .. (Window and "OK" or "FAIL"))
    task.spawn(function()
        task.wait(0.5)
        pcall(function()
            local search = {}
            pcall(function() for _, g in ipairs(CoreGui:GetChildren()) do if g:IsA("ScreenGui") then search[#search+1] = g end end end)
            pcall(function() if gethui then for _, g in ipairs(gethui():GetChildren()) do if g:IsA("ScreenGui") then search[#search+1] = g end end end)
            for _, sg in ipairs(search) do
                local nm = sg.Name:lower()
                if nm:find("wind") or nm:find("seraphim") then
                    if sg ~= MobileToggle.gui and sg ~= BallHUD.gui then
                        for _, desc in ipairs(sg:GetDescendants()) do
                            if desc:IsA("Frame") and desc.Active then
                                local cam = workspace.CurrentCamera
                                local vp = cam and cam.ViewportSize or Vector2.new(1920,1080)
                                local sz = desc.AbsoluteSize
                                if sz.X >= vp.X * 0.9 and sz.Y >= vp.Y * 0.9 then
                                    desc.Active = false
                                    desc.Size = UDim2.fromOffset(0,0)
                                    desc.BackgroundTransparency = 1
                                end
                            end
                        end
                        ourGuis[#ourGuis + 1] = sg
                    end
                end
            end
        end)
    end)

    -- WindUI tabs
    if Window then
        local function sTab(p) local ok, t = pcall(function() return Window:Tab(p) end); return ok and t or nil end
        local function sSec(tab, p) if not tab then return nil end; local ok, s = pcall(function() return tab:Section(p) end); return ok and s or nil end
        local function sTog(parent, p) if parent then pcall(function() parent:Toggle(p) end) end end
        local function sSld(parent, p) if parent then pcall(function() parent:Slider(p) end) end end
        local function sBtn(parent, p) if parent then pcall(function() parent:Button(p) end) end end
        local function sPar(parent, p) if not parent then return nil end; local ok, q = pcall(function() return parent:Paragraph(p) end); return ok and q or nil end
        local function sSpc(parent) if parent then pcall(function() parent:Space() end) end end

        local MainTab = sTab({ Title = "Main", Icon = "solar:home-2-bold" })
        if MainTab then
            local S1 = sSec(MainTab, { Title = "Remote Capture", Opened = true })
            sPar(S1, { Title = "How to capture", Desc = "1. Tap purple UI to hide menu\n2. Tap BLOCK to parry\n3. Reopen menu\n4. Tap Capture Last Fire" })
            sSpc(S1)
            sBtn(S1, { Title = "Capture Last Fire", Icon = "zap", Callback = function()
                local ok, info = captureFromLastFire()
                _G.WindUI_Notify(ok and "Captured" or "Failed", info)
            end })
            sSpc(S1)
            sBtn(S1, { Title = "Dump Last 20 Fires", Icon = "terminal", Callback = function()
                print("=== RECENT FIRES ===")
                for i = max(1, #recentFires - 19), #recentFires do
                    local f = recentFires[i]
                    print(("[%d] %s n=%d"):format(i, f.remote:GetFullName(), f.args.n))
                end
            end })

            local S2 = sSec(MainTab, { Title = "Auto Parry" })
            sTog(S2, { Title = "Auto Parry", Value = cfg.ap,
                Callback = function(v) cfg.ap = v; saveCfg(); if v then startAP() else stopAP() end end })
            sTog(S2, { Title = "Adaptive Accuracy", Value = cfg.adaptiveAcc,
                Callback = function(v) cfg.adaptiveAcc = v; saveCfg() end })
            sSpc(S2)
            sSld(S2, { Title = "Accuracy", Value = { Min = 1, Max = 200, Default = cfg.acc }, Step = 1,
                Callback = function(v) cfg.acc = v; curAcc = accValue(v); baseAcc = curAcc; saveCfg() end })

            local S3 = sSec(MainTab, { Title = "Smart Spam" })
            sTog(S3, { Title = "Smart Spam", Value = cfg.ms,
                Callback = function(v) cfg.ms = v; saveCfg(); if v then startMS() else stopMS() end end })
            sTog(S3, { Title = "Turbo Mode", Value = cfg.turbo,
                Callback = function(v) cfg.turbo = v; saveCfg() end })
            sSpc(S3)
            sSld(S3, { Title = "Spam Speed (ms)", Value = { Min = 0, Max = 40, Default = cfg.spam_speed }, Step = 1,
                Callback = function(v) cfg.spam_speed = v; saveCfg() end })

            local S4 = sSec(MainTab, { Title = "Visual" })
            sTog(S4, { Title = "Ball HUD", Value = cfg.ballHUD, Callback = function(v) cfg.ballHUD = v; saveCfg() end })
            sSpc(S4)
            sBtn(S4, { Title = "Hide UI (do this to block)", Icon = "eye-off", Callback = function() toggleUI() end })

            local S5 = sSec(MainTab, { Title = "Status" })
            local statusP = sPar(S5, { Title = "Remote: MISSING • Token: MISSING" })
            if statusP then
                task.spawn(function()
                    while _G.sera do
                        task.wait(0.6)
                        pcall(function()
                            local r = captured.remote and "OK" or "MISSING"
                            local t = key and "OK" or "MISSING"
                            local rname = captured.remote and captured.remote.Name or "none"
                            statusP:SetTitle(("Remote: %s (%s) • Token: %s"):format(r, rname, t))
                        end)
                    end
                end)
            end
        end

        local UtilTab = sTab({ Title = "Utility", Icon = "solar:settings-bold" })
        if UtilTab then
            local U1 = sSec(UtilTab, { Title = "Character", Opened = true })
            sSld(U1, { Title = "Walk Speed", Value = { Min = 16, Max = 250, Default = cfg.walkSpeed }, Step = 1,
                Callback = function(v) cfg.walkSpeed = v; saveCfg()
                    pcall(function()
                        local c = LP.Character; local h = c and c:FindFirstChildOfClass("Humanoid")
                        if h then h.WalkSpeed = v end
                    end)
                end })
            sSpc(U1)
            sSld(U1, { Title = "Jump Power", Value = { Min = 50, Max = 500, Default = cfg.jumpPower }, Step = 5,
                Callback = function(v) cfg.jumpPower = v; saveCfg()
                    pcall(function()
                        local c = LP.Character; local h = c and c:FindFirstChildOfClass("Humanoid")
                        if h then h.UseJumpPower = true; h.JumpPower = v end
                    end)
                end })
            sSpc(U1)
            sBtn(U1, { Title = "Rejoin", Icon = "log-out",
                Callback = function() pcall(function() game:GetService("TeleportService"):Teleport(game.PlaceId, LP) end) end })
        end

        local VisTab = sTab({ Title = "Visuals", Icon = "solar:eye-bold" })
        if VisTab then
            local V1 = sSec(VisTab, { Title = "Environment", Opened = true })
            sTog(V1, { Title = "Fullbright", Value = cfg.fullbright, Callback = function(v)
                cfg.fullbright = v; saveCfg()
                if v then Lighting.Brightness = 3; Lighting.ClockTime = 12; Lighting.GlobalShadows = false; Lighting.FogEnd = 1e9
                else Lighting.Brightness = 2; Lighting.GlobalShadows = true; Lighting.FogEnd = 100000 end
            end })
            sTog(V1, { Title = "FPS Unlocker (240)", Value = cfg.fps, Callback = function(v)
                cfg.fps = v; saveCfg(); pcall(function() setfpscap(v and 240 or 60) end)
            end })
        end
    end
else
    -- FALLBACK UI
    log("building fallback UI")
    pcall(function()
        local par = CoreGui
        pcall(function() if gethui then par = gethui() end end)
        local sg = Instance.new("ScreenGui", par)
        sg.Name = "SeraphimFallback"
        sg.ResetOnSpawn = false
        sg.IgnoreGuiInset = true
        sg.DisplayOrder = 500
        _G.sera_fallback = sg
        ourGuis[#ourGuis + 1] = sg

        local fr = Instance.new("Frame", sg)
        fr.Size = UDim2.fromOffset(240, 400)
        fr.Position = UDim2.new(0, 20, 0, 100)
        fr.BackgroundColor3 = Color3.fromRGB(20, 20, 28)
        fr.BorderSizePixel = 0
        Instance.new("UICorner", fr).CornerRadius = UDim.new(0, 12)
        local stroke = Instance.new("UIStroke", fr)
        stroke.Color = Color3.fromRGB(139, 92, 246); stroke.Thickness = 2

        local title = Instance.new("TextLabel", fr)
        title.Size = UDim2.new(1, 0, 0, 32)
        title.BackgroundTransparency = 1
        title.Text = "Seraphim (fallback)"
        title.Font = Enum.Font.GothamBold
        title.TextSize = 14
        title.TextColor3 = Color3.new(1, 1, 1)

        local y = 38
        local function mkBtn(txt, cb)
            local b_ = Instance.new("TextButton", fr)
            b_.Size = UDim2.new(1, -20, 0, 34)
            b_.Position = UDim2.new(0, 10, 0, y)
            b_.BackgroundColor3 = Color3.fromRGB(139, 92, 246)
            b_.TextColor3 = Color3.new(1, 1, 1)
            b_.Font = Enum.Font.GothamBold
            b_.TextSize = 13
            b_.Text = txt
            b_.BorderSizePixel = 0
            Instance.new("UICorner", b_).CornerRadius = UDim.new(0, 8)
            b_.MouseButton1Click:Connect(cb)
            y = y + 38
        end
        mkBtn("Toggle Auto Parry", function()
            cfg.ap = not cfg.ap; saveCfg()
            if cfg.ap then startAP() else stopAP() end
            _G.WindUI_Notify("AP", cfg.ap and "ON" or "OFF")
        end)
        mkBtn("Toggle Spam", function()
            cfg.ms = not cfg.ms; saveCfg()
            if cfg.ms then startMS() else stopMS() end
            _G.WindUI_Notify("Spam", cfg.ms and "ON" or "OFF")
        end)
        mkBtn("Capture Last Fire", function()
            local ok, info = captureFromLastFire()
            _G.WindUI_Notify(ok and "Captured" or "Failed", info)
        end)
        mkBtn("Dump Last 20 Fires", function()
            print("=== RECENT FIRES ===")
            for i = max(1, #recentFires - 19), #recentFires do
                local f = recentFires[i]
                print(("[%d] %s n=%d"):format(i, f.remote:GetFullName(), f.args.n))
            end
        end)
        mkBtn("Toggle Ball HUD", function() cfg.ballHUD = not cfg.ballHUD; saveCfg() end)
        mkBtn("Toggle Fullbright", function()
            cfg.fullbright = not cfg.fullbright; saveCfg()
            if cfg.fullbright then Lighting.Brightness = 3; Lighting.ClockTime = 12; Lighting.GlobalShadows = false; Lighting.FogEnd = 1e9
            else Lighting.Brightness = 2; Lighting.GlobalShadows = true; Lighting.FogEnd = 100000 end
        end)
        mkBtn("Rejoin", function()
            pcall(function() game:GetService("TeleportService"):Teleport(game.PlaceId, LP) end)
        end)
        mkBtn("Hide UI", function() toggleUI() end)
    end)
end

-- ============================================================
-- HOTKEY + CHAT
-- ============================================================
UIS.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
    if input.KeyCode.Name == "K" then if toggleUI then toggleUI() end
    elseif input.KeyCode.Name == (cfg.spamKey or "P") then
        cfg.ms = not cfg.ms
        if cfg.ms then startMS() else stopMS() end
        saveCfg()
    end
end)

LP.Chatted:Connect(function(msg)
    if msg:sub(1,1) ~= ";" then return end
    local args = {}
    for tok in string.gmatch(msg:sub(2), "%S+") do args[#args+1] = tok end
    if #args == 0 then return end
    local cmd = args[1]:lower()
    if cmd == "cap" then
        local ok, info = captureFromLastFire()
        print(ok and ("Captured: " .. info) or ("Failed: " .. info))
    elseif cmd == "hideui" then if toggleUI then toggleUI() end
    elseif cmd == "ap" then
        cfg.ap = (args[2] or "on"):lower() ~= "off"; saveCfg()
        if cfg.ap then startAP() else stopAP() end
    elseif cmd == "spam" then
        cfg.ms = (args[2] or "on"):lower() ~= "off"; saveCfg()
        if cfg.ms then startMS() else stopMS() end
    end
end)

-- ============================================================
-- STARTUP
-- ============================================================
createMobileToggle()
log("mobile toggle created")

task.spawn(function()
    task.wait(1)
    if cfg.fps then pcall(function() setfpscap(240) end) end
    if cfg.fullbright then Lighting.Brightness = 3; Lighting.ClockTime = 12; Lighting.GlobalShadows = false; Lighting.FogEnd = 1e9 end
    if cfg.ap then startAP() end
    if cfg.ms then startMS() end
end)

log("ALL DONE — v21 loaded")
_G.WindUI_Notify("Seraphim v21", WindUIOK and "Loaded - tap purple UI circle" or "Fallback UI active - check console")
