-- Seraphim v22 - guaranteed load
if _G.sera then warn("Already running") return end
_G.sera = true
local function log(s) print("[Seraphim] " .. tostring(s)) end
log("start")

-- Everything wrapped so we always get an error message
local MAIN_OK, MAIN_ERR = pcall(function()

pcall(function()
    local mt = getrawmetatable(game)
    if mt and mt.__namecall then
        local old = mt.__namecall
        setreadonly(mt, false)
        mt.__namecall = newcclosure(function(self, ...)
            if tostring(getnamecallmethod()) == "Kick" and self == game:GetService("Players").LocalPlayer then return end
            return old(self, ...)
        end)
        setreadonly(mt, true)
    end
end)

if not game:IsLoaded() then game.Loaded:Wait() end
log("game loaded")

local RS = game:GetService("ReplicatedStorage")
local UIS = game:GetService("UserInputService")
local Run = game:GetService("RunService")
local Players = game:GetService("Players")
local Stats = game:GetService("Stats")
local CoreGui = game:GetService("CoreGui")
local LP = Players.LocalPlayer
local HS = game:GetService("HttpService")
local Lighting = game:GetService("Lighting")
local b, ch = string.byte, string.char
local fl, xo = math.floor, bit32.bxor
local clamp, abs = math.clamp, math.abs
local min, max, floor = math.min, math.max, math.floor
local tick, huge, v3 = tick, math.huge, Vector3.new
local cfLook = CFrame.lookAt
local hook = hookfunction or getgenv().hookfunction

-- Forward declarations
local toggleUI
local MobileToggle = { gui=nil, frame=nil }
local BallHUD = { gui=nil, container=nil, rows={} }
local ourGuis = {}

-- ============================================================
-- REMOTE CAPTURE
-- ============================================================
local remoteScores, remoteLastArgs, recentFires = {}, {}, {}
local captured, votes, key = {}, {}, nil
local _tsC, _tsV = -1, ""
local function ts()
    local n = fl(workspace:GetServerTimeNow() * 100)
    if n ~= _tsC then _tsC, _tsV = n, tostring(n) end
    return _tsV
end
local function learn(t, s)
    if #t ~= #s then return false end
    for i = 1, #t do
        local v = xo(b(t, i), (b(s, i) + i) % 256)
        local vi = votes[i] or {}; votes[i] = vi
        vi[v] = (vi[v] or 0) + 1
    end
    local nk = table.create(#t)
    for i = 1, #t do
        local vi, best, hi = votes[i], 0, -1
        for v, c in next, vi do if c > hi then best, hi = v, c end end
        nk[i] = best
    end
    key = nk
    return true
end
local function mkToken()
    if not key then return nil end
    local s = ts()
    local L, n = #s, #key
    local t = table.create(L)
    for i = 1, L do
        local v = key[i] or key[n]
        if not v then return nil end
        t[i] = ch(xo((b(s, i) + i) % 256, v))
    end
    return table.concat(t)
end
local _cachedToken, _cachedTokenT = nil, -1
local function getTokenFast()
    local now = tick()
    if now - _cachedTokenT < 0.01 and _cachedToken then return _cachedToken end
    _cachedToken = mkToken()
    _cachedTokenT = now
    return _cachedToken
end
local function pushFire(remote, a)
    recentFires[#recentFires + 1] = { remote = remote, args = a, t = tick() }
    while #recentFires > 25 do table.remove(recentFires, 1) end
end
local function bumpRemoteScore(r, amt) remoteScores[r] = (remoteScores[r] or 0) + (amt or 1) end

local _fire
if hook then
    pcall(function()
        _fire = hook(Instance.new("RemoteEvent").FireServer, function(self, ...)
            local a = table.pack(...)
            pushFire(self, a)
            if type(a[1]) == "string" and type(a[3]) == "string" and type(a[4]) == "number" and a.n >= 5 then
                bumpRemoteScore(self, 0.5)
                if not remoteLastArgs[self] then remoteLastArgs[self] = a end
            end
            if captured.remote == self and type(a[3]) == "string" then
                captured.sessionKey = a[2] or captured.sessionKey
                captured.timing = a[4] or captured.timing
                captured.tailBool = a[8] or captured.tailBool
                captured.argCount = a.n
                captured.args = a
                learn(a[3], ts())
            end
            return _fire(self, ...)
        end)
    end)
end

pcall(function()
    local mt = getrawmetatable(game)
    if mt and mt.__namecall then
        local oldNamecall = mt.__namecall
        setreadonly(mt, false)
        mt.__namecall = newcclosure(function(self, ...)
            local m = getnamecallmethod and getnamecallmethod()
            if m == "FireServer" then
                local a = table.pack(...)
                pushFire(self, a)
                if type(a[1]) == "string" and type(a[3]) == "string" and type(a[4]) == "number" and a.n >= 5 then
                    bumpRemoteScore(self, 0.5)
                    if not remoteLastArgs[self] then remoteLastArgs[self] = a end
                end
                if captured.remote == self and type(a[3]) == "string" then
                    captured.sessionKey = a[2] or captured.sessionKey
                    captured.timing = a[4] or captured.timing
                    captured.tailBool = a[8] or captured.tailBool
                    captured.argCount = a.n
                    captured.args = a
                    learn(a[3], ts())
                end
            end
            return oldNamecall(self, ...)
        end)
        setreadonly(mt, true)
    end
end)
log("hooks installed")

local function correlateOnParry()
    local now = tick()
    local bestRemote, bestScore = nil, 0
    for i = #recentFires, 1, -1 do
        local f = recentFires[i]
        if now - f.t > 1.5 then break end
        local a = f.args
        if type(a[1]) == "string" and type(a[3]) == "string" and type(a[4]) == "number" then
            local s = (1.5 - (now - f.t)) * 3
            if s > bestScore then bestRemote, bestScore = f.remote, s end
        end
    end
    if bestRemote then
        bumpRemoteScore(bestRemote, 5)
        local args = remoteLastArgs[bestRemote]
        if not args then
            for i = #recentFires, 1, -1 do
                if recentFires[i].remote == bestRemote then args = recentFires[i].args; break end
            end
        end
        if args and (not captured.remote or (remoteScores[bestRemote] or 0) > (remoteScores[captured.remote] or 0)) then
            captured.remote = bestRemote
            captured.hash = args[1]; captured.sessionKey = args[2]; captured.token = args[3]
            captured.timing = args[4]; captured.tailBool = args[8]; captured.argCount = args.n
            captured.args = args
            if type(args[3]) == "string" then learn(args[3], ts()) end
            log("CORRELATED: " .. bestRemote:GetFullName())
            if _G.WindUI_Notify then _G.WindUI_Notify("Remote Captured", bestRemote:GetFullName()) end
        end
    end
end

local function captureFromLastFire()
    if #recentFires == 0 then return false, "no fires logged" end
    for i = #recentFires, 1, -1 do
        local f = recentFires[i]
        local a = f.args
        if type(a[1]) == "string" and type(a[3]) == "string" then
            captured.remote = f.remote
            captured.hash = a[1]; captured.sessionKey = a[2]; captured.token = a[3]
            captured.timing = a[4]; captured.tailBool = a[8]; captured.argCount = a.n
            captured.args = a
            learn(a[3], ts())
            return true, f.remote:GetFullName()
        end
    end
    return false, "no valid candidate"
end

-- ============================================================
-- TRACKER
-- ============================================================
local Tracker = { balls = {} }
local CW, CMS, CAT = 0.18, 8, 0.35
function Tracker.get(id)
    local t = Tracker.balls[id]
    if not t then
        t = { speeds={}, velSamples={}, avgSp=0, angVel=0, curvature=0, isCurving=false, curveInt=0, lastT=0 }
        Tracker.balls[id] = t
    end
    return t
end
function Tracker.reset(id) Tracker.balls[id] = nil end
local function rotY(v, a)
    local c, s = math.cos(a), math.sin(a)
    return v3(v.X*c + v.Z*s, v.Y, -v.X*s + v.Z*c)
end
function Tracker.update(ball)
    local z = ball:FindFirstChild("zoomies"); if not z then return nil end
    local id = ball:GetDebugId(); local t = Tracker.get(id)
    local now = tick(); local v = z.VectorVelocity; local sp = v.Magnitude
    t.speeds[#t.speeds + 1] = sp
    if #t.speeds > 12 then table.remove(t.speeds, 1) end
    local sum = 0; for i = 1, #t.speeds do sum = sum + t.speeds[i] end
    t.avgSp = sum / #t.speeds; t.lastT = now
    t.velSamples[#t.velSamples + 1] = { v = v, t = now, sp = sp }
    while #t.velSamples > 2 and (now - t.velSamples[1].t) > CW * 2 do table.remove(t.velSamples, 1) end
    if #t.velSamples >= 3 then
        local newer = t.velSamples[#t.velSamples]
        local older = t.velSamples[1]
        for i = #t.velSamples - 1, 1, -1 do
            if (newer.t - t.velSamples[i].t) >= CW * 0.7 then older = t.velSamples[i]; break end
        end
        local dt = newer.t - older.t
        if dt > 0.02 and older.sp >= CMS and newer.sp >= CMS then
            local a = math.acos(clamp(older.v.Unit:Dot(newer.v.Unit), -1, 1))
            local sign = older.v.Unit:Cross(newer.v.Unit).Y >= 0 and 1 or -1
            local av = (a / dt) * sign
            if abs(av) < 25 then t.angVel = t.angVel + (av - t.angVel) * 0.35 end
            t.curvature = abs(t.angVel) / math.max(newer.sp, 1)
            t.isCurving = abs(t.angVel) > CAT and newer.sp > CMS
            t.curveInt = clamp((abs(t.angVel) - CAT) / 3.5, 0, 1)
        end
    end
    return t
end

-- ============================================================
-- CONFIG
-- ============================================================
local cfg = {
    ap=false, ms=false, spf=4, acc=65, spam_speed=3, turbo=false,
    walkSpeed=16, jumpPower=50, antiAfk=false, autoRejoin=false,
    curveAware=true, fps=true, fullbright=false, noFog=false,
    spamKey="P", toggleX=nil, toggleY=nil, uiHidden=false,
    ballHUD=true, adaptiveAcc=true,
}
local CFG_PATH = "seraphim_cfg.json"
local function saveCfg() pcall(function() if writefile then writefile(CFG_PATH, HS:JSONEncode(cfg)) end end) end
pcall(function()
    if isfile and isfile(CFG_PATH) then
        for k, v in pairs(HS:JSONDecode(readfile(CFG_PATH))) do cfg[k] = v end
    end
end)

local AccPts = {
    {65, 0.8307070707070668}, {80, 1.0254040404040357}, {90, 1.1552020202020148},
    {100, 1.284999999999994}, {140, 1.8}, {200, 2.582979797979786},
}
local function accValue(v)
    v = clamp(v, 1, 200)
    if v <= AccPts[1][1] then return AccPts[1][2] end
    if v >= AccPts[#AccPts][1] then return AccPts[#AccPts][2] end
    for i = 1, #AccPts - 1 do
        local a, b_ = AccPts[i], AccPts[i+1]
        if v >= a[1] and v <= b_[1] then
            return a[2] + (b_[2] - a[2]) * ((v - a[1]) / (b_[1] - a[1]))
        end
    end
    return AccPts[1][2]
end
local curAcc = accValue(cfg.acc)
local baseAcc = curAcc

-- ============================================================
-- STATS + PING
-- ============================================================
local S = { parries=0, attempts=0, sessionStart=tick(), pps={}, misses=0 }
local function bumpParry()
    S.parries = S.parries + 1
    S.pps[#S.pps + 1] = tick()
    while #S.pps > 0 and tick() - S.pps[1] > 60 do table.remove(S.pps, 1) end
end
local function parryRate() return #S.pps end
local _pingEMA, _pingSamples = 0, 0
local function getPing()
    local ok, p = pcall(function() return Stats.Network.ServerStatsItem["Data Ping"]:GetValue() end)
    if not ok or not p then return 60 end
    if _pingSamples == 0 then _pingEMA = p
    else _pingEMA = _pingEMA + (p - _pingEMA) * 0.25 end
    _pingSamples = _pingSamples + 1
    return _pingEMA
end

-- ============================================================
-- BALLS
-- ============================================================
local _ballCache, _ballDirty = {}, true
local function markDirty() _ballDirty = true end
do
    local bf = workspace:FindFirstChild("Balls")
    if bf then bf.ChildAdded:Connect(markDirty); bf.ChildRemoved:Connect(markDirty) end
end
local function getBalls()
    if _ballDirty then
        _ballDirty = false
        local bf = workspace:FindFirstChild("Balls")
        if not bf then _ballCache = {}; return _ballCache end
        local t = {}
        for _, x in ipairs(bf:GetChildren()) do
            if x:GetAttribute("realBall") then t[#t+1] = x end
        end
        _ballCache = t
    end
    return _ballCache
end

-- ============================================================
-- FIRING
-- ============================================================
local firedBalls, lastFirePerBall = {}, {}
local lastSpamFire = 0
local _lastCF, _lastCFT = nil, -1
local function computeCF()
    local now = tick()
    if _lastCF and now - _lastCFT < 0.02 then return _lastCF end
    _lastCFT = now
    local cam = workspace.CurrentCamera
    local c = LP.Character; local h = c and c.PrimaryPart
    if not h then _lastCF = cam.CFrame; return _lastCF end
    local mp = UIS:GetMouseLocation()
    local ray = cam:ViewportPointToRay(mp.X, mp.Y)
    local closest, cd = nil, huge
    local alive = workspace:FindFirstChild("Alive")
    if alive then
        for _, x in ipairs(alive:GetChildren()) do
            if x ~= c then
                local pp = x.PrimaryPart
                if pp then
                    local delta = pp.Position - cam.CFrame.Position
                    if delta.Unit:Dot(ray.Direction) > 0.5 then
                        local m = delta.Magnitude
                        if m < cd then cd = m; closest = x end
                    end
                end
            end
        end
    end
    local tp = (closest and closest.PrimaryPart) and closest.PrimaryPart.Position
        or (h.Position + cam.CFrame.LookVector * 1000)
    _lastCF = cfLook(h.Position, tp + v3(0, 1.75, 0))
    return _lastCF
end
local _spCache, _spCacheT = {}, -1
local function buildScreenPoints(cam)
    local now = tick()
    if now - _spCacheT < 0.03 then return _spCache end
    _spCacheT = now
    local sp = {}
    local alive = workspace:FindFirstChild("Alive")
    if alive then
        for _, x in ipairs(alive:GetChildren()) do
            local pp = x.PrimaryPart
            if pp then
                local ok, pt = pcall(cam.WorldToScreenPoint, cam, pp.Position)
                if ok then sp[x.Name] = pt end
            end
        end
    end
    _spCache = sp
    return sp
end

local function fireNoYield(n)
    if not _fire then return end
    local rem, sk = captured.remote, captured.sessionKey
    if not rem or not sk then return end
    local token = getTokenFast(); if not token then return end
    local cam = workspace.CurrentCamera
    local sp = buildScreenPoints(cam)
    local mp = UIS:GetMouseLocation()
    local cf = computeCF()
    local ms = { mp.X, mp.Y }
    local tail = captured.tailBool or false
    local timing = captured.timing or 0.5
    S.attempts = S.attempts + n
    pcall(function()
        for i = 1, n do
            if captured.hash then
                _fire(rem, captured.hash, sk, token, timing, cf, sp, ms, tail)
            else
                _fire(rem, sk, token, timing, cf, sp, ms, tail)
            end
        end
    end)
end

local function startAP()
    if _G.sera_apConn then _G.sera_apConn:Disconnect() end
    _G.sera_apConn = Run.PreSimulation:Connect(function()
        if not cfg.ap then return end
        local c = LP.Character; if not c or not c.PrimaryPart then return end
        local hrp = c.PrimaryPart
        local now = tick()
        local pingBase = clamp(getPing() / 10, 4, 15)
        local myName = LP.Name
        local hrpPos = hrp.Position

        for id, fireTime in pairs(lastFirePerBall) do
            if now - fireTime > 0.8 then
                firedBalls[id] = nil; lastFirePerBall[id] = nil
            end
        end
        for _, ball in ipairs(getBalls()) do
            local id = ball:GetDebugId()
            if firedBalls[id] then
                local tgt = ball:GetAttribute("target")
                if tgt ~= myName then
                    firedBalls[id] = nil; lastFirePerBall[id] = nil
                else
                    local z = ball:FindFirstChild("zoomies")
                    if z then
                        local v = z.VectorVelocity
                        local toBall = ball.Position - hrpPos
                        if toBall.Magnitude > 0.5 and v.Unit:Dot(toBall.Unit) < -0.15 then
                            firedBalls[id] = nil; lastFirePerBall[id] = nil
                        end
                    end
                end
            end
        end

        local threats = {}
        for _, ball in ipairs(getBalls()) do
            local id = ball:GetDebugId()
            if firedBalls[id] then continue end
            local lf = lastFirePerBall[id]
            if lf and (now - lf) < 0.02 then continue end
            if ball:GetAttribute("target") ~= myName then continue end
            local z = ball:FindFirstChild("zoomies"); if not z then continue end
            local t = Tracker.update(ball); if not t then continue end
            local v = z.VectorVelocity
            local sp = t.avgSp > 3 and t.avgSp or v.Magnitude
            if sp < 3 then continue end
            local delta = hrpPos - ball.Position
            local dist = delta.Magnitude
            local dot = v.Unit:Dot(delta.Unit)
            if dot <= 0.05 then continue end
            local eta = dist / (sp * dot)
            local threat = (1 / math.max(eta, 0.05)) * (1 + (t.curveInt or 0) * 0.5)
            threats[#threats + 1] = { id=id, dist=dist, sp=sp, t=t, threat=threat }
        end
        if #threats == 0 then return end
        table.sort(threats, function(a, b_) return a.threat > b_.threat end)

        local fireCount = math.min(#threats, 2)
        for i = 1, fireCount do
            local th = threats[i]
            local avgSp = th.t.avgSp > 3 and th.t.avgSp or th.sp
            local speedAdj = min(max(avgSp - 9.5, 0), 700)
            local scaledAg = (2.6 + speedAdj * 0.0025) * curAcc
            local targetDist = pingBase + max(avgSp / scaledAg, 8.5)
            local isC = th.t.isCurving
            local cur = th.t.curveInt or 0
            local shots = 4
            if isC then
                targetDist = targetDist * (1.15 + cur * 0.45)
                shots = 6 + floor(cur * 6)
            else
                if avgSp > 150 then shots = 5 end
                if avgSp > 220 then shots = 6 end
                if avgSp > 300 then shots = 8 end
            end
            if cfg.spf == 8 then shots = shots + 2 end
            if i > 1 then shots = math.max(3, floor(shots / 2)) end
            if th.dist <= targetDist then
                fireNoYield(shots)
                firedBalls[th.id] = true
                lastFirePerBall[th.id] = now
            end
        end
    end)
end
local function stopAP()
    if _G.sera_apConn then _G.sera_apConn:Disconnect(); _G.sera_apConn = nil end
    firedBalls = {}; lastFirePerBall = {}; Tracker.balls = {}
end

pcall(function()
    RS.Remotes.ParrySuccess.OnClientEvent:Connect(function()
        bumpParry(); correlateOnParry()
        for id in pairs(firedBalls) do firedBalls[id] = nil end
        lastFirePerBall = {}
    end)
end)

local function startMS()
    if _G.sera_msConn then _G.sera_msConn:Disconnect() end
    lastSpamFire = 0
    _G.sera_msConn = Run.PreSimulation:Connect(function()
        if not cfg.ms then return end
        local c = LP.Character; local h = c and c.PrimaryPart; if not h then return end
        if cfg.turbo then fireNoYield(max(cfg.spf, 4)); return end
        local hp = h.Position
        local nearest = huge
        for _, ball in ipairs(getBalls()) do
            local d = (hp - ball.Position).Magnitude
            if d < nearest then nearest = d end
        end
        if nearest > 80 then return end
        local baseGap = cfg.spam_speed / 1000
        local gap = nearest < 25 and baseGap * 0.6 or (nearest < 45 and baseGap * 0.85 or baseGap)
        local now = tick()
        if now - lastSpamFire < gap then return end
        lastSpamFire = now
        local burst = cfg.spf
        if nearest < 20 then burst = burst + 2 end
        fireNoYield(burst)
    end)
end
local function stopMS()
    if _G.sera_msConn then _G.sera_msConn:Disconnect(); _G.sera_msConn = nil end
    lastSpamFire = 0
end

-- ============================================================
-- BALL HUD
-- ============================================================
local function destroyBallHUD()
    if BallHUD.gui then BallHUD.gui:Destroy() end
    BallHUD.gui = nil; BallHUD.container = nil; BallHUD.rows = {}
end
local function buildBallHUD()
    if BallHUD.gui then return end
    local par = CoreGui
    pcall(function() if gethui then par = gethui() end end)
    local sg = Instance.new("ScreenGui", par)
    sg.Name = "SeraphimBallHUD"; sg.ResetOnSpawn = false
    sg.IgnoreGuiInset = true; sg.DisplayOrder = 3500
    BallHUD.gui = sg
    local fr = Instance.new("Frame", sg)
    fr.Size = UDim2.fromOffset(220, 40)
    fr.Position = UDim2.new(1, -228, 0, 40)
    fr.BackgroundColor3 = Color3.fromRGB(14, 14, 20)
    fr.BackgroundTransparency = 0.2; fr.BorderSizePixel = 0
    BallHUD.container = fr
    Instance.new("UICorner", fr).CornerRadius = UDim.new(0, 8)
    local stroke = Instance.new("UIStroke", fr)
    stroke.Color = Color3.fromRGB(139, 92, 246); stroke.Thickness = 1; stroke.Transparency = 0.4
    local title = Instance.new("TextLabel", fr)
    title.Size = UDim2.new(1, -10, 0, 18); title.Position = UDim2.new(0, 5, 0, 2)
    title.BackgroundTransparency = 1; title.Text = "BALLS"
    title.Font = Enum.Font.GothamBold; title.TextSize = 10
    title.TextColor3 = Color3.fromRGB(180, 150, 240)
    title.TextXAlignment = Enum.TextXAlignment.Left
    local rowsFrame = Instance.new("Frame", fr)
    rowsFrame.Size = UDim2.new(1, -8, 1, -22); rowsFrame.Position = UDim2.new(0, 4, 0, 20)
    rowsFrame.BackgroundTransparency = 1
    BallHUD.rowsFrame = rowsFrame
    Instance.new("UIListLayout", rowsFrame).Padding = UDim.new(0, 2)
end

task.spawn(function()
    while _G.sera do
        task.wait(0.1)
        if cfg.ballHUD then
            if not BallHUD.gui then buildBallHUD() end
            local myPos = LP.Character and LP.Character.PrimaryPart and LP.Character.PrimaryPart.Position
            local myName = LP.Name
            local active = {}
            for _, ball in ipairs(getBalls()) do
                if ball:GetAttribute("target") == myName then
                    local z = ball:FindFirstChild("zoomies")
                    if z then
                        local t = Tracker.get(ball:GetDebugId())
                        active[#active + 1] = { sp = t.avgSp or 0, dist = myPos and (ball.Position - myPos).Magnitude or 0, t = t }
                    end
                end
            end
            if BallHUD.container then
                BallHUD.container.Size = UDim2.fromOffset(220, 24 + math.max(1, #active) * 14)
            end
            for i = 1, math.max(#active, #(BallHUD.rows or {})) do
                if not BallHUD.rows[i] and BallHUD.rowsFrame then
                    local l = Instance.new("TextLabel", BallHUD.rowsFrame)
                    l.Size = UDim2.new(1, 0, 0, 12); l.BackgroundTransparency = 1
                    l.Font = Enum.Font.Code; l.TextSize = 10
                    l.TextColor3 = Color3.fromRGB(220, 220, 240)
                    l.TextXAlignment = Enum.TextXAlignment.Left
                    l.LayoutOrder = i
                    BallHUD.rows[i] = l
                end
                local r = BallHUD.rows[i]
                if r then
                    if i <= #active then
                        local a = active[i]
                        local cm = a.t.isCurving and ("*%.2f"):format(a.t.curveInt) or ""
                        r.Text = ("#%d %.0fsps %.0fm %s"):format(i, a.sp, a.dist, cm)
                        r.TextColor3 = a.t.isCurving and Color3.fromRGB(255, 180, 80) or Color3.fromRGB(200, 220, 255)
                        r.Visible = true
                    else r.Visible = false end
                end
            end
        else
            if BallHUD.gui then destroyBallHUD() end
        end
    end
end)

-- ============================================================
-- MOBILE TOGGLE
-- ============================================================
local function createMobileToggle()
    if MobileToggle.gui then return end
    local par = CoreGui
    pcall(function() if gethui then par = gethui() end end)
    local sg = Instance.new("ScreenGui", par)
    sg.Name = "SeraphimMobileToggle"; sg.ResetOnSpawn = false
    sg.IgnoreGuiInset = true; sg.DisplayOrder = 10000
    MobileToggle.gui = sg
    local BTN = 52
    local fr = Instance.new("Frame", sg)
    fr.Size = UDim2.fromOffset(BTN, BTN)
    local cam = workspace.CurrentCamera
    local vp = cam and cam.ViewportSize or Vector2.new(400, 800)
    local ix = clamp(cfg.toggleX or 20, 0, max(0, vp.X - BTN))
    local iy = clamp(cfg.toggleY or floor(vp.Y * 0.7), 0, max(0, vp.Y - BTN))
    fr.Position = UDim2.fromOffset(ix, iy)
    fr.BackgroundColor3 = Color3.fromRGB(139, 92, 246)
    fr.BackgroundTransparency = 0.2; fr.BorderSizePixel = 0; fr.Active = true
    MobileToggle.frame = fr
    Instance.new("UICorner", fr).CornerRadius = UDim.new(0, 26)
    local stroke = Instance.new("UIStroke", fr)
    stroke.Color = Color3.fromRGB(220, 220, 240); stroke.Thickness = 2; stroke.Transparency = 0.3
    local lbl = Instance.new("TextLabel", fr)
    lbl.Size = UDim2.new(1, 0, 1, 0); lbl.BackgroundTransparency = 1
    lbl.Text = "UI"; lbl.Font = Enum.Font.GothamBold
    lbl.TextSize = 18; lbl.TextColor3 = Color3.new(1,1,1)
    local dI, sT, sX, sY, moved = nil, nil, 0, 0, false
    fr.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then
            dI, sT = i, i.Position; sX, sY = fr.Position.X.Offset, fr.Position.Y.Offset; moved = false
        end
    end)
    UIS.InputChanged:Connect(function(i)
        if dI ~= i then return end
        if i.UserInputType ~= Enum.UserInputType.Touch and i.UserInputType ~= Enum.UserInputType.MouseMovement then return end
        local dx = i.Position.X - sT.X
        local dy = i.Position.Y - sT.Y
        if abs(dx) > 8 or abs(dy) > 8 then moved = true end
        local vp2 = (workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize) or Vector2.new(400, 800)
        fr.Position = UDim2.fromOffset(clamp(sX+dx, 0, max(0, vp2.X-BTN)), clamp(sY+dy, 0, max(0, vp2.Y-BTN)))
    end)
    UIS.InputEnded:Connect(function(i)
        if dI == i then
            dI = nil
            if moved then cfg.toggleX, cfg.toggleY = fr.Position.X.Offset, fr.Position.Y.Offset; saveCfg()
            else if toggleUI then toggleUI() end end
        end
    end)
end

-- ============================================================
-- LOAD WINDUI
-- ============================================================
log("loading WindUI...")
local WindUIOK, WindUI = false, nil
local WINDUI_URLS = {
    "https://raw.githubusercontent.com/Footagesus/WindUI/refs/heads/main/main_example.lua",
    "https://raw.githubusercontent.com/Footagesus/WindUI/main/dist/main.lua",
    "https://raw.githubusercontent.com/Footagesus/WindUI/main/main.lua",
    "https://raw.githubusercontent.com/Footagesus/WindUI/master/main.lua",
    "https://github.com/Footagesus/WindUI/releases/latest/download/main.lua",
    "https://raw.githubusercontent.com/Footagesus/WindUI/main/source/main.lua",
}
for i, url in ipairs(WINDUI_URLS) do
    if WindUIOK then break end
    pcall(function()
        local src = game:HttpGet(url)
        if not src or #src < 1000 then error("src too short: " .. tostring(src and #src)) end
        local fn = loadstring(src)
        if not fn then error("loadstring returned nil") end
        local result = fn()
        if type(result) == "table" and (result.CreateWindow or result.Window) then
            WindUI = result
            WindUIOK = true
            log("WindUI loaded from URL #" .. i)
        elseif type(result) == "table" then
            WindUI = result
            WindUIOK = true
            log("WindUI-like table loaded from URL #" .. i)
        else
            log("URL #" .. i .. " returned " .. type(result) .. " — trying next")
        end
    end)
    if not WindUIOK then
        log("URL #" .. i .. " failed")
    end
end
if not WindUIOK then warn("[Seraphim] All WindUI URLs failed — using custom UI") end

_G.WindUI_Notify = function(title, content)
    if WindUI and WindUIOK then
        pcall(function() WindUI:Notify({ Title = title, Content = content }) end)
    end
end

-- ============================================================
-- toggleUI
-- ============================================================
function toggleUI()
    cfg.uiHidden = not cfg.uiHidden; saveCfg()
    for _, sg in ipairs(ourGuis) do pcall(function() sg.Enabled = not cfg.uiHidden end) end
    pcall(function()
        local search = {}
        pcall(function() for _, g in ipairs(CoreGui:GetChildren()) do if g:IsA("ScreenGui") then search[#search+1] = g end end end)
        pcall(function() if gethui then for _, g in ipairs(gethui():GetChildren()) do if g:IsA("ScreenGui") then search[#search+1] = g end end end)
        for _, g in ipairs(search) do
            if g ~= MobileToggle.gui and g ~= BallHUD.gui then
                local nm = g.Name:lower()
                if nm:find("wind") or nm:find("seraphim") then g.Enabled = not cfg.uiHidden end
            end
        end
    end)
end

-- ============================================================
-- BUILD UI (WindUI or fallback)
-- ============================================================
local Window = nil
if WindUIOK then
    pcall(function()
        Window = WindUI:CreateWindow({
            Title = "Seraphim",
            Author = "v22",
            Icon = "solar:shield-bold",
            Folder = "Seraphim",
            Size = UDim2.fromOffset(560, 440),
        })
    end)
    log("window: " .. (Window and "OK" or "FAIL"))
end

if Window then
    -- WindUI UI
    local function sTab(p) local ok, t = pcall(function() return Window:Tab(p) end); return ok and t or nil end
    local function sSec(tab, p) if not tab then return nil end; local ok, s = pcall(function() return tab:Section(p) end); return ok and s or nil end
    local function sTog(parent, p) if parent then pcall(function() parent:Toggle(p) end) end end
    local function sSld(parent, p) if parent then pcall(function() parent:Slider(p) end) end end
    local function sBtn(parent, p) if parent then pcall(function() parent:Button(p) end) end end
    local function sPar(parent, p) if not parent then return nil end; local ok, q = pcall(function() return parent:Paragraph(p) end); return ok and q or nil end
    local function sSpc(parent) if parent then pcall(function() parent:Space() end) end end

    local MainTab = sTab({ Title = "Main", Icon = "solar:home-2-bold" })
    if MainTab then
        local S1 = sSec(MainTab, { Title = "Remote Capture", Opened = true })
        sPar(S1, { Title = "Steps", Desc = "1. Tap purple UI to hide\n2. Tap BLOCK to parry\n3. Reopen, tap Capture" })
        sSpc(S1)
        sBtn(S1, { Title = "Capture Last Fire", Icon = "zap", Callback = function()
            local ok, info = captureFromLastFire()
            _G.WindUI_Notify(ok and "Captured" or "Failed", info)
        end })
        sSpc(S1)
        sBtn(S1, { Title = "Dump Last 20 Fires", Icon = "terminal", Callback = function()
            print("=== FIRES ===")
            for i = max(1, #recentFires - 19), #recentFires do
                local f = recentFires[i]
                print(("[%d] %s n=%d"):format(i, f.remote:GetFullName(), f.args.n))
            end
        end })

        local S2 = sSec(MainTab, { Title = "Auto Parry" })
        sTog(S2, { Title = "Auto Parry", Value = cfg.ap,
            Callback = function(v) cfg.ap = v; saveCfg(); if v then startAP() else stopAP() end end })
        sTog(S2, { Title = "Adaptive Accuracy", Value = cfg.adaptiveAcc,
            Callback = function(v) cfg.adaptiveAcc = v; saveCfg() end })
        sSpc(S2)
        sSld(S2, { Title = "Accuracy", Value = { Min = 1, Max = 200, Default = cfg.acc }, Step = 1,
            Callback = function(v) cfg.acc = v; curAcc = accValue(v); baseAcc = curAcc; saveCfg() end })

        local S3 = sSec(MainTab, { Title = "Spam" })
        sTog(S3, { Title = "Smart Spam", Value = cfg.ms,
            Callback = function(v) cfg.ms = v; saveCfg(); if v then startMS() else stopMS() end end })
        sTog(S3, { Title = "Turbo Mode", Value = cfg.turbo,
            Callback = function(v) cfg.turbo = v; saveCfg() end })
        sSpc(S3)
        sSld(S3, { Title = "Spam Speed (ms)", Value = { Min = 0, Max = 40, Default = cfg.spam_speed }, Step = 1,
            Callback = function(v) cfg.spam_speed = v; saveCfg() end })

        local S4 = sSec(MainTab, { Title = "Visual" })
        sTog(S4, { Title = "Ball HUD", Value = cfg.ballHUD, Callback = function(v) cfg.ballHUD = v; saveCfg() end })
        sSpc(S4)
        sBtn(S4, { Title = "Hide UI", Icon = "eye-off", Callback = toggleUI })

        local S5 = sSec(MainTab, { Title = "Status" })
        local statusP = sPar(S5, { Title = "Remote: MISSING • Token: MISSING" })
        if statusP then
            task.spawn(function()
                while _G.sera do
                    task.wait(0.6)
                    pcall(function()
                        local r = captured.remote and "OK" or "MISSING"
                        local t = key and "OK" or "MISSING"
                        local rname = captured.remote and captured.remote.Name or "none"
                        statusP:SetTitle(("Remote: %s (%s) • Token: %s"):format(r, rname, t))
                    end)
                end
            end)
        end
    end

    local UtilTab = sTab({ Title = "Utility", Icon = "solar:settings-bold" })
    if UtilTab then
        local U1 = sSec(UtilTab, { Title = "Character", Opened = true })
        sSld(U1, { Title = "Walk Speed", Value = { Min = 16, Max = 250, Default = cfg.walkSpeed }, Step = 1,
            Callback = function(v) cfg.walkSpeed = v; saveCfg()
                pcall(function()
                    local c = LP.Character; local h = c and c:FindFirstChildOfClass("Humanoid")
                    if h then h.WalkSpeed = v end
                end)
            end })
        sSpc(U1)
        sSld(U1, { Title = "Jump Power", Value = { Min = 50, Max = 500, Default = cfg.jumpPower }, Step = 5,
            Callback = function(v) cfg.jumpPower = v; saveCfg()
                pcall(function()
                    local c = LP.Character; local h = c and c:FindFirstChildOfClass("Humanoid")
                    if h then h.UseJumpPower = true; h.JumpPower = v end
                end)
            end })
        sSpc(U1)
        sBtn(U1, { Title = "Rejoin", Icon = "log-out",
            Callback = function() pcall(function() game:GetService("TeleportService"):Teleport(game.PlaceId, LP) end) end })
    end

    local VisTab = sTab({ Title = "Visuals", Icon = "solar:eye-bold" })
    if VisTab then
        local V1 = sSec(VisTab, { Title = "Environment", Opened = true })
        sTog(V1, { Title = "Fullbright", Value = cfg.fullbright, Callback = function(v)
            cfg.fullbright = v; saveCfg()
            if v then Lighting.Brightness = 3; Lighting.ClockTime = 12; Lighting.GlobalShadows = false; Lighting.FogEnd = 1e9
            else Lighting.Brightness = 2; Lighting.GlobalShadows = true; Lighting.FogEnd = 100000 end
        end })
        sTog(V1, { Title = "FPS Unlocker", Value = cfg.fps, Callback = function(v)
            cfg.fps = v; saveCfg(); pcall(function() setfpscap(v and 240 or 60) end)
        end })
    end
else
    -- ============================================================
    -- CUSTOM FALLBACK UI (always works)
    -- ============================================================
    log("building custom fallback UI")
    local par = CoreGui
    pcall(function() if gethui then par = gethui() end end)
    local sg = Instance.new("ScreenGui", par)
    sg.Name = "SeraphimUI"
    sg.ResetOnSpawn = false
    sg.IgnoreGuiInset = true
    sg.DisplayOrder = 500
    ourGuis[#ourGuis + 1] = sg

    local FR_W, FR_H = 250, 480
    local fr = Instance.new("Frame", sg)
    fr.Size = UDim2.fromOffset(FR_W, FR_H)
    fr.Position = UDim2.new(0.5, -FR_W/2, 0.5, -FR_H/2)
    fr.BackgroundColor3 = Color3.fromRGB(18, 18, 26)
    fr.BorderSizePixel = 0
    fr.Active = true
    Instance.new("UICorner", fr).CornerRadius = UDim.new(0, 14)
    local mstr = Instance.new("UIStroke", fr)
    mstr.Color = Color3.fromRGB(139, 92, 246); mstr.Thickness = 2

    -- Title bar (drag)
    local tb = Instance.new("Frame", fr)
    tb.Size = UDim2.new(1, 0, 0, 40)
    tb.BackgroundColor3 = Color3.fromRGB(26, 26, 36)
    tb.BorderSizePixel = 0
    Instance.new("UICorner", tb).CornerRadius = UDim.new(0, 14)
    local tfix = Instance.new("Frame", tb)
    tfix.Size = UDim2.new(1, 0, 0, 14); tfix.Position = UDim2.new(0, 0, 1, -14)
    tfix.BackgroundColor3 = Color3.fromRGB(26, 26, 36); tfix.BorderSizePixel = 0

    local tLbl = Instance.new("TextLabel", tb)
    tLbl.Size = UDim2.new(1, -60, 1, 0); tLbl.Position = UDim2.new(0, 14, 0, 0)
    tLbl.BackgroundTransparency = 1
    tLbl.Text = "Seraphim v22"
    tLbl.Font = Enum.Font.GothamBold; tLbl.TextSize = 15
    tLbl.TextColor3 = Color3.fromRGB(230, 230, 245)
    tLbl.TextXAlignment = Enum.TextXAlignment.Left

    local xBtn = Instance.new("TextButton", tb)
    xBtn.Size = UDim2.fromOffset(30, 30); xBtn.Position = UDim2.new(1, -36, 0, 5)
    xBtn.BackgroundColor3 = Color3.fromRGB(46, 46, 60)
    xBtn.Text = "X"; xBtn.Font = Enum.Font.GothamBold; xBtn.TextSize = 14
    xBtn.TextColor3 = Color3.fromRGB(230, 230, 240)
    xBtn.BorderSizePixel = 0
    Instance.new("UICorner", xBtn).CornerRadius = UDim.new(0, 6)
    xBtn.MouseButton1Click:Connect(function() sg.Enabled = false end)

    -- Drag
    local dragging, dragInput, dragStart, startPos = false, nil, nil, nil
    tb.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true; dragInput = i; dragStart = i.Position; startPos = fr.Position
        end
    end)
    UIS.InputChanged:Connect(function(i)
        if not dragging or dragInput ~= i then return end
        if i.UserInputType ~= Enum.UserInputType.Touch and i.UserInputType ~= Enum.UserInputType.MouseMovement then return end
        local d = i.Position - dragStart
        fr.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
    end)
    UIS.InputEnded:Connect(function(i)
        if dragInput == i then dragging = false; dragInput = nil end
    end)

    local content = Instance.new("ScrollingFrame", fr)
    content.Size = UDim2.new(1, -16, 1, -54)
    content.Position = UDim2.new(0, 8, 0, 46)
    content.BackgroundTransparency = 1; content.BorderSizePixel = 0
    content.ScrollBarThickness = 4
    content.ScrollBarImageColor3 = Color3.fromRGB(139, 92, 246)
    content.CanvasSize = UDim2.new(0, 0, 0, 0)
    content.AutomaticCanvasSize = Enum.AutomaticSize.Y
    local cl = Instance.new("UIListLayout", content)
    cl.Padding = UDim.new(0, 6)

    local function section(txt)
        local s = Instance.new("TextLabel", content)
        s.Size = UDim2.new(1, 0, 0, 22); s.BackgroundTransparency = 1
        s.Text = txt; s.Font = Enum.Font.GothamBold; s.TextSize = 11
        s.TextColor3 = Color3.fromRGB(150, 150, 180)
        s.TextXAlignment = Enum.TextXAlignment.Left
    end
    local function btn(txt, cb)
        local b_ = Instance.new("TextButton", content)
        b_.Size = UDim2.new(1, 0, 0, 40)
        b_.BackgroundColor3 = Color3.fromRGB(139, 92, 246)
        b_.Text = txt; b_.Font = Enum.Font.GothamBold
        b_.TextSize = 13; b_.TextColor3 = Color3.new(1,1,1)
        b_.BorderSizePixel = 0
        Instance.new("UICorner", b_).CornerRadius = UDim.new(0, 8)
        b_.MouseButton1Click:Connect(function() pcall(cb) end)
    end
    local function toggle(txt, getter, setter)
        local row = Instance.new("Frame", content)
        row.Size = UDim2.new(1, 0, 0, 42)
        row.BackgroundColor3 = Color3.fromRGB(26, 26, 36); row.BorderSizePixel = 0
        Instance.new("UICorner", row).CornerRadius = UDim.new(0, 8)
        local l = Instance.new("TextLabel", row)
        l.Size = UDim2.new(1, -70, 1, 0); l.Position = UDim2.new(0, 12, 0, 0)
        l.BackgroundTransparency = 1; l.Text = txt
        l.Font = Enum.Font.Gotham; l.TextSize = 13
        l.TextColor3 = Color3.fromRGB(230, 230, 245)
        l.TextXAlignment = Enum.TextXAlignment.Left
        local ind = Instance.new("Frame", row)
        ind.Size = UDim2.fromOffset(46, 24); ind.Position = UDim2.new(1, -56, 0.5, -12)
        ind.BackgroundColor3 = getter() and Color3.fromRGB(139, 92, 246) or Color3.fromRGB(50, 50, 68)
        ind.BorderSizePixel = 0
        Instance.new("UICorner", ind).CornerRadius = UDim.new(0, 12)
        local k = Instance.new("Frame", ind)
        k.Size = UDim2.fromOffset(18, 18)
        k.Position = getter() and UDim2.new(1, -20, 0.5, -9) or UDim2.new(0, 2, 0.5, -9)
        k.BackgroundColor3 = Color3.new(1,1,1); k.BorderSizePixel = 0
        Instance.new("UICorner", k).CornerRadius = UDim.new(0, 9)
        local btn_ = Instance.new("TextButton", row)
        btn_.Size = UDim2.new(1, 0, 1, 0); btn_.BackgroundTransparency = 1; btn_.Text = ""
        btn_.MouseButton1Click:Connect(function()
            local new = not getter()
            setter(new)
            ind.BackgroundColor3 = new and Color3.fromRGB(139, 92, 246) or Color3.fromRGB(50, 50, 68)
            k.Position = new and UDim2.new(1, -20, 0.5, -9) or UDim2.new(0, 2, 0.5, -9)
        end)
    end
    local function slider(txt, mn, mx, getter, setter, step)
        step = step or 1
        local row = Instance.new("Frame", content)
        row.Size = UDim2.new(1, 0, 0, 56)
        row.BackgroundColor3 = Color3.fromRGB(26, 26, 36); row.BorderSizePixel = 0
        Instance.new("UICorner", row).CornerRadius = UDim.new(0, 8)
        local l = Instance.new("TextLabel", row)
        l.Size = UDim2.new(1, -80, 0, 20); l.Position = UDim2.new(0, 12, 0, 6)
        l.BackgroundTransparency = 1; l.Text = txt
        l.Font = Enum.Font.Gotham; l.TextSize = 13
        l.TextColor3 = Color3.fromRGB(230, 230, 245)
        l.TextXAlignment = Enum.TextXAlignment.Left
        local v = Instance.new("TextLabel", row)
        v.Size = UDim2.fromOffset(60, 20); v.Position = UDim2.new(1, -72, 0, 6)
        v.BackgroundTransparency = 1
        v.Text = tostring(math.floor(getter() + 0.5))
        v.Font = Enum.Font.GothamBold; v.TextSize = 12
        v.TextColor3 = Color3.fromRGB(180, 150, 240)
        v.TextXAlignment = Enum.TextXAlignment.Right
        local track = Instance.new("Frame", row)
        track.Size = UDim2.new(1, -24, 0, 6); track.Position = UDim2.new(0, 12, 0, 36)
        track.BackgroundColor3 = Color3.fromRGB(46, 46, 60); track.BorderSizePixel = 0
        Instance.new("UICorner", track).CornerRadius = UDim.new(0, 3)
        local fill = Instance.new("Frame", track)
        fill.BackgroundColor3 = Color3.fromRGB(139, 92, 246)
        fill.BorderSizePixel = 0
        Instance.new("UICorner", fill).CornerRadius = UDim.new(0, 3)
        local k = Instance.new("Frame", track)
        k.Size = UDim2.fromOffset(14, 14); k.BackgroundColor3 = Color3.new(1,1,1)
        k.BorderSizePixel = 0
        Instance.new("UICorner", k).CornerRadius = UDim.new(0, 7)
        local function upd(val)
            local c = clamp(val, mn, mx)
            local a = (c - mn) / (mx - mn)
            fill.Size = UDim2.new(a, 0, 1, 0)
            k.Position = UDim2.new(a, -7, 0.5, -7)
            v.Text = tostring(math.floor(c + 0.5))
            setter(c)
        end
        upd(getter())
        local dragging_ = false
        local function handle(px)
            local ap = track.AbsolutePosition
            local sw = track.AbsoluteSize.X
            if sw <= 0 then return end
            local a = clamp((px - ap.X) / sw, 0, 1)
            local raw = mn + (mx - mn) * a
            upd(math.floor(raw / step + 0.5) * step)
        end
        local b_ = Instance.new("TextButton", row)
        b_.Size = UDim2.new(1, 0, 1, 0); b_.BackgroundTransparency = 1; b_.Text = ""
        b_.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging_ = true; handle(i.Position.X)
            end
        end)
        UIS.InputChanged:Connect(function(i)
            if not dragging_ then return end
            if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseMovement then
                handle(i.Position.X)
            end
        end)
        UIS.InputEnded:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging_ = false
            end
        end)
    end

    section("Remote Capture")
    btn("Capture Last Fire", function()
        local ok, info = captureFromLastFire()
        print(ok and ("Captured: " .. info) or ("Failed: " .. info))
    end)
    btn("Dump Last 20 Fires", function()
        print("=== FIRES ===")
        for i = max(1, #recentFires - 19), #recentFires do
            local f = recentFires[i]
            print(("[%d] %s n=%d"):format(i, f.remote:GetFullName(), f.args.n))
        end
    end)

    section("Auto Parry")
    toggle("Auto Parry", function() return cfg.ap end, function(v)
        cfg.ap = v; saveCfg(); if v then startAP() else stopAP() end
    end)
    toggle("Adaptive Accuracy", function() return cfg.adaptiveAcc end, function(v)
        cfg.adaptiveAcc = v; saveCfg()
    end)
    slider("Accuracy", 1, 200, function() return cfg.acc end, function(v)
        cfg.acc = v; curAcc = accValue(v); baseAcc = curAcc; saveCfg()
    end, 1)

    section("Spam")
    toggle("Smart Spam", function() return cfg.ms end, function(v)
        cfg.ms = v; saveCfg(); if v then startMS() else stopMS() end
    end)
    toggle("Turbo Mode", function() return cfg.turbo end, function(v)
        cfg.turbo = v; saveCfg()
    end)
    slider("Spam Speed (ms)", 0, 40, function() return cfg.spam_speed end, function(v)
        cfg.spam_speed = v; saveCfg()
    end, 1)

    section("Visual")
    toggle("Ball HUD", function() return cfg.ballHUD end, function(v) cfg.ballHUD = v; saveCfg() end)
    toggle("Fullbright", function() return cfg.fullbright end, function(v)
        cfg.fullbright = v; saveCfg()
        if v then Lighting.Brightness = 3; Lighting.ClockTime = 12; Lighting.GlobalShadows = false; Lighting.FogEnd = 1e9
        else Lighting.Brightness = 2; Lighting.GlobalShadows = true; Lighting.FogEnd = 100000 end
    end)

    section("Utility")
    slider("Walk Speed", 16, 250, function() return cfg.walkSpeed end, function(v)
        cfg.walkSpeed = v; saveCfg()
        pcall(function()
            local c = LP.Character; local h = c and c:FindFirstChildOfClass("Humanoid")
            if h then h.WalkSpeed = v end
        end)
    end, 1)
    slider("Jump Power", 50, 500, function() return cfg.jumpPower end, function(v)
        cfg.jumpPower = v; saveCfg()
        pcall(function()
            local c = LP.Character; local h = c and c:FindFirstChildOfClass("Humanoid")
            if h then h.UseJumpPower = true; h.JumpPower = v end
        end)
    end, 5)
    btn("Rejoin", function() pcall(function() game:GetService("TeleportService"):Teleport(game.PlaceId, LP) end) end)
end

-- ============================================================
-- ADAPTIVE ACCURACY
-- ============================================================
task.spawn(function()
    while _G.sera do
        task.wait(2)
        if cfg.adaptiveAcc and S.attempts > 20 then
            local ratio = S.parries / max(S.parries + S.misses, 1)
            local target = baseAcc
            if ratio < 0.5 then target = baseAcc * 0.92
            elseif ratio > 0.8 then target = baseAcc * 1.06 end
            curAcc = curAcc + (target - curAcc) * 0.3
        else
            curAcc = baseAcc
        end
    end
end)

-- ============================================================
-- HOTKEYS + CHAT
-- ============================================================
UIS.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
    if input.KeyCode.Name == "K" then if toggleUI then toggleUI() end
    elseif input.KeyCode.Name == (cfg.spamKey or "P") then
        cfg.ms = not cfg.ms
        if cfg.ms then startMS() else stopMS() end
        saveCfg()
    end
end)

LP.Chatted:Connect(function(msg)
    if msg:sub(1,1) ~= ";" then return end
    local args = {}
    for tok in string.gmatch(msg:sub(2), "%S+") do args[#args+1] = tok end
    if #args == 0 then return end
    local cmd = args[1]:lower()
    if cmd == "cap" then
        local ok, info = captureFromLastFire()
        print(ok and ("Captured: " .. info) or ("Failed: " .. info))
    elseif cmd == "hideui" then if toggleUI then toggleUI() end
    elseif cmd == "ap" then
        cfg.ap = (args[2] or "on"):lower() ~= "off"; saveCfg()
        if cfg.ap then startAP() else stopAP() end
    elseif cmd == "spam" then
        cfg.ms = (args[2] or "on"):lower() ~= "off"; saveCfg()
        if cfg.ms then startMS() else stopMS() end
    elseif cmd == "hud" then
        cfg.ballHUD = (args[2] or "on"):lower() ~= "off"; saveCfg()
    end
end)

-- ============================================================
-- STARTUP
-- ============================================================
createMobileToggle()
log("mobile toggle created")

task.spawn(function()
    task.wait(1)
    if cfg.fps then pcall(function() setfpscap(240) end) end
    if cfg.fullbright then Lighting.Brightness = 3; Lighting.ClockTime = 12; Lighting.GlobalShadows = false; Lighting.FogEnd = 1e9 end
    if cfg.ap then startAP() end
    if cfg.ms then startMS() end
end)

log("ALL DONE — v22")

end)  -- MAIN_OK pcall

if not MAIN_OK then
    warn("[Seraphim] CRASHED: " .. tostring(MAIN_ERR))
    -- Emergency minimal UI
    pcall(function()
        local par = game:GetService("CoreGui")
        pcall(function() if gethui then par = gethui() end end)
        local sg = Instance.new("ScreenGui", par)
        sg.Name = "SeraphimCrash"
        local fr = Instance.new("Frame", sg)
        fr.Size = UDim2.fromOffset(300, 100)
        fr.Position = UDim2.new(0, 20, 0, 100)
        fr.BackgroundColor3 = Color3.fromRGB(80, 20, 20)
        local t = Instance.new("TextLabel", fr)
        t.Size = UDim2.new(1, -20, 1, -20)
        t.Position = UDim2.new(0, 10, 0, 10)
        t.BackgroundTransparency = 1
        t.Text = "Seraphim crashed:\n" .. tostring(MAIN_ERR)
        t.TextColor3 = Color3.new(1,1,1)
        t.Font = Enum.Font.GothamBold
        t.TextSize = 12
        t.TextWrapped = true
        t.TextXAlignment = Enum.TextXAlignment.Left
    end)
end

if _G.WindUI_Notify then
    _G.WindUI_Notify("Seraphim v22", "Loaded")
end
