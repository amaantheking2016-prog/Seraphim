]]-- ====================== BALL REGISTRY ====================================
-- Incremental real-ball tracking. Zero allocation in the hot path.
local BallRegistry = {
    real = {}, training = {},
    realList = {}, trainingList = {},
    dirty = true, conns = {},
}
local function registryMarkDirty() BallRegistry.dirty = true end
local function registryRebuild()
    local r, t = {}, {}
    for b in pairs(BallRegistry.real) do if b.Parent then r[#r+1] = b end end
    for b in pairs(BallRegistry.training) do if b.Parent then t[#t+1] = b end end
    BallRegistry.realList = r
    BallRegistry.trainingList = t
    BallRegistry.dirty = false
end
local function registryAdd(ball, isTraining)
    if ball:GetAttribute("realBall") then
        if isTraining then BallRegistry.training[ball] = true
        else BallRegistry.real[ball] = true end
        registryMarkDirty()
    end
end
local function registryRemove(ball)
    if BallRegistry.real[ball] then BallRegistry.real[ball] = nil; registryMarkDirty() end
    if BallRegistry.training[ball] then BallRegistry.training[ball] = nil; registryMarkDirty() end
end
local function registryInit()
    local balls = workspace:WaitForChild("Balls")
    local tb    = workspace:FindFirstChild("TrainingBalls")
    for _, b in ipairs(balls:GetChildren()) do registryAdd(b, false) end
    BallRegistry.conns[#BallRegistry.conns+1] = balls.ChildAdded:Connect(function(b) registryAdd(b, false) end)
    BallRegistry.conns[#BallRegistry.conns+1] = balls.ChildRemoved:Connect(registryRemove)
    if tb then
        for _, b in ipairs(tb:GetChildren()) do registryAdd(b, true) end
        BallRegistry.conns[#BallRegistry.conns+1] = tb.ChildAdded:Connect(function(b) registryAdd(b, true) end)
        BallRegistry.conns[#BallRegistry.conns+1] = tb.ChildRemoved:Connect(registryRemove)
    else
        task.spawn(function()
            local t = workspace:WaitForChild("TrainingBalls", 30)
            if not t then return end
            for _, b in ipairs(t:GetChildren()) do registryAdd(b, true) end
            BallRegistry.conns[#BallRegistry.conns+1] = t.ChildAdded:Connect(function(b) registryAdd(b, true) end)
            BallRegistry.conns[#BallRegistry.conns+1] = t.ChildRemoved:Connect(registryRemove)
        end)
    end
end
registryInit()
function BallRegistry.iterate()
    if BallRegistry.dirty then registryRebuild() end
    return BallRegistry.realList
end
function BallRegistry.iterateTraining()
    if BallRegistry.dirty then registryRebuild() end
    return BallRegistry.trainingList
end
function BallRegistry.first()
    if BallRegistry.dirty then registryRebuild() end
    return BallRegistry.realList[1]
end

-- ====================== PARRY STATE MACHINE =============================
local ParryState = {
    status = "IDLE",
    lockedUntil = 0,
    lastFireAt = 0,
    cooldownUntil = 0,
    inFlight = 0,
}
function ParryState.canFire()
    return ParryState.status ~= "LOCKED"
       and tick() >= ParryState.lockedUntil
       and tick() >= ParryState.cooldownUntil
       and ParryState.inFlight == 0
end
function ParryState.markFired()
    ParryState.inFlight = 1
    ParryState.lockedUntil = tick() + CFG.parryLockSeconds
    ParryState.lastFireAt = tick()
    ParryState.status = "COOLDOWN"
    task.delay(CFG.parryResetSeconds, function()
        ParryState.inFlight = 0
        ParryState.cooldownUntil = 0
        if ParryState.status == "COOLDOWN" then ParryState.status = "IDLE" end
    end)
end
local ParryMutex = { held = false }
local function withParryMutex(fn)
    if ParryMutex.held then return false end
    ParryMutex.held = true
    local ok, res = pcall(fn)
    ParryMutex.held = false
    return ok and res
end

-- ====================== STATS2 ===========================================
local Stats2 = { events = {}, head = 0, capacity = 512 }
function Stats2.push(kind)
    local i = (Stats2.head % Stats2.capacity) + 1
    Stats2.events[i] = { t = tick(), kind = kind }
    Stats2.head = i
end
function Stats2.rate(kind)
    local now = tick()
    local cutoff = now - CFG.statsWindowSec
    local n = 0
    for i = 1, Stats2.capacity do
        local e = Stats2.events[i]
        if e and e.t >= cutoff and (not kind or e.kind == kind) then n = n + 1 end
    end
    return n / CFG.statsWindowSec
end
function Stats2.errorRate() return Stats2.rate("error") end

-- ====================== TARGET ===========================================
local Target = { current = nil, recently = {} }
function Target.pickRandom()
    local living = {}
    for _, char in ipairs(workspace.Alive:GetChildren()) do
        if char.Name ~= LocalPlayer.Name and char.PrimaryPart then
            living[#living + 1] = char
        end
    end
    if #living == 0 then Target.current = nil; return end
    if #living == 1 then Target.current = living[1]; return end
    local candidates = {}
    for _, c in ipairs(living) do
        if not Target.recently[c.Name] then candidates[#candidates + 1] = c end
    end
    if #candidates == 0 then
        Target.recently = {}
        for _, c in ipairs(living) do
            if not Target.current or c.Name ~= Target.current.Name then
                candidates[#candidates + 1] = c
            end
        end
        if #candidates == 0 then candidates = living end
    end
    local picked = candidates[math.random(1, #candidates)]
    Target.recently[picked.Name] = true
    Target.current = picked
end
function Target.selectByMouse()
    local living = {}
    for _, char in ipairs(workspace.Alive:GetChildren()) do
        if char.Name ~= LocalPlayer.Name and char.PrimaryPart then
            living[#living + 1] = char
        end
    end
    local cam = workspace.CurrentCamera
    local mp  = UserInputServiceX:GetMouseLocation()
    local ray = cam:ScreenPointToRay(mp.X, mp.Y)
    local rayDir = ray.Direction
    local best, bestDot = nil, -math.huge
    for _, c in ipairs(living) do
        local dir = (c.PrimaryPart.Position - cam.CFrame.Position).Unit
        local dot = rayDir:Dot(dir)
        if dot > bestDot then bestDot = dot; best = c end
    end
    Target.current = best
    return best
end
task.spawn(function()
    local balls = workspace:WaitForChild("Balls")
    local function watch(b)
        b:GetAttributeChangedSignal("target"):Connect(function()
            if Config.RandomTarget then Target.pickRandom() end
        end)
    end
    for _, b in ipairs(balls:GetChildren()) do watch(b) end
    balls.ChildAdded:Connect(function(b)
        if Config.RandomTarget then Target.pickRandom() end
        watch(b)
    end)
end)

-- ====================== BALL HELPER ======================================
local BallHelper = {}
BallHelper.ball = { properties = {
    aerodynamic_time = tick(), last_warping = tick(),
    lerp_radians = 0, curving = tick(),
}}
function BallHelper.get_ball()  return BallRegistry.first() end
function BallHelper.get_balls() return BallRegistry.iterate() end
function BallHelper.get_training_balls() return BallRegistry.iterateTraining() end

local function linear_predict(a, b, t) return a + (b - a) * t end

local CurveState = setmetatable({}, { __mode = "k" })
local function getCurveState(ball)
    local s = CurveState[ball]
    if not s then
        s = { aerodynamic_time = tick(), last_warping = tick(), lerp_radians = 0, curving = tick() }
        CurveState[ball] = s
    end
    return s
end

function BallHelper.ball_curvedFor(ball)
    if not ball or not ball.Parent then return false end
    local props = getCurveState(ball)
    local zoomies = ball:FindFirstChild("zoomies")
    if not zoomies then return false end
    local velocity = zoomies.VectorVelocity
    if not velocity then return false end
    local speed = velocity.Magnitude
    if speed <= 0 then return false end
    local myRoot = LocalPlayer.Character and LocalPlayer.Character.PrimaryPart
    if not myRoot then return false end
    local velUnit = velocity.Unit
    local toMe = (myRoot.Position - ball.Position).Unit
    local dotProduct = toMe:Dot(velUnit)
    local speedFactor = math.min(speed / 100, 40)
    local accelDir = (velUnit - velocity).Unit
    local crossDot = toMe:Dot(accelDir)
    local dotDifference = dotProduct - crossDot
    local distance = (myRoot.Position - ball.Position).Magnitude
    local pingMs = PingCache.get()
    local pingThreshold = 0.5 - (pingMs / 1000)
    local timeToImpact = distance / speed - (pingMs / 1000)
    local minDistance = 15 - math.min(distance / 1000, 15) + speedFactor
    local clampedDot = math.clamp(dotProduct, -1, 1)
    local angleRad = math.rad(math.asin(clampedDot))
    props.lerp_radians = linear_predict(props.lerp_radians, angleRad, 0.8)
    if speed > 100 and timeToImpact > pingMs / 10 then
        minDistance = math.max(minDistance - 15, 15)
    end
    if distance < minDistance then return false end
    if dotDifference < pingThreshold then return true end
    if props.lerp_radians < 0.018 then props.last_warping = tick() end
    if (tick() - props.last_warping) < (timeToImpact / 1.5) then return true end
    if (tick() - props.curving) < (timeToImpact / 1.5) then return true end
    return dotProduct < pingThreshold
end
function BallHelper.ball_curved()
    return BallHelper.ball_curvedFor(BallRegistry.first())
end

function BallHelper.getCurveCFrame()
    local cam = workspace.CurrentCamera
    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return cam.CFrame end
    local method = Config.CurveMode
    local target = Target.current
    local targetPos = (target and target.PrimaryPart and target.PrimaryPart.Position)
        or (hrp.Position + cam.CFrame.LookVector * 1000)
    local toTarget = (targetPos - hrp.Position)
    if toTarget.Magnitude < 1e-3 then toTarget = Vector3.new(0, 0, -1) end
    toTarget = toTarget.Unit
    if method == "dot" then
        return CFrame.lookAt(hrp.Position, targetPos + Vector3.new(0, 1.75, 0))
    elseif method == "backwards" then
        return CFrame.new(hrp.Position, hrp.Position + (-toTarget) * 1000)
    elseif method == "slow" then
        return CFrame.new(hrp.Position, hrp.Position + Vector3.new(0, -350, 0))
    elseif method == "random" then
        return CFrame.new(hrp.Position, targetPos + Vector3.new(
            math.random(-1000, 1000), math.random(-350, 1000), math.random(-1000, 1000)))
    elseif method == "high" then
        return CFrame.new(hrp.Position, targetPos + Vector3.new(0, 9e18, 0))
    elseif method == "accelerated" then
        return CFrame.new(hrp.Position, targetPos + Vector3.new(0, 5, 0))
    else
        return cam.CFrame
    end
end

-- ====================== PARRY KEY CAPTURE ================================
local Parry = { count = 0, keyFn = nil }
do
    local SC
    if ReplicatedStorage:FindFirstChild("Controllers") then
        for _, child in ipairs(ReplicatedStorage.Controllers:GetChildren()) do
            if child.Name:match("^SwordsController%s*$") then SC = child end
        end
    end
    safe(function()
        local pg = LocalPlayer.PlayerGui:FindFirstChild("Hotbar")
        local blk = pg and pg:FindFirstChild("Block")
        if blk and SC then
            for _, v in next, getconnections(blk.Activated) do
                if getfenv(v.Function).script == SC then
                    Parry.keyFn = v.Function; break
                end
            end
        end
    end)
end

-- ====================== PARRY FIRE =======================================
local SB = {
    screen = {}, screenKeys = {}, screenCount = 0,
    mouseLoc = {0, 0}, fired = 0,
    lastScreenRefresh = 0, screenTTL = 0.10,
}
for i = 1, 32 do SB.screenKeys[i] = false end

local function clearScreen()
    for i = 1, SB.screenCount do SB.screen[SB.screenKeys[i]] = nil end
    SB.screenCount = 0
end
local function refreshScreen()
    clearScreen()
    local alive = workspace.Alive
    local cam = workspace.CurrentCamera
    local n = 0
    for _, c in ipairs(alive:GetChildren()) do
        local pp = c.PrimaryPart
        if pp then
            n += 1
            SB.screenKeys[n] = c.Name
            SB.screen[c.Name] = cam:WorldToScreenPoint(pp.Position)
        end
    end
    SB.screenCount = n
    SB.lastScreenRefresh = tick()
end

function BallHelper.parry()
    if not Remote.isArmed() then return false end
    if not ParryState.canFire() then return false end
    if not Config.RandomTarget then Target.selectByMouse() end
    if tick() - SB.lastScreenRefresh > SB.screenTTL then refreshScreen() end
    local curveCFrame = BallHelper.getCurveCFrame()
    if Config.RandomTarget and Target.current and Target.current.PrimaryPart then
        local vp = workspace.CurrentCamera:WorldToViewportPoint(Target.current.PrimaryPart.Position)
        SB.mouseLoc[1] = vp.X
        SB.mouseLoc[2] = vp.Y
    else
        local mp = UserInputServiceX:GetMouseLocation()
        SB.mouseLoc[1] = mp.X
        SB.mouseLoc[2] = mp.Y
    end
    local function doFire()
        local token = Remote.makeToken()
        if not token then return false end
        local cap = Remote.captured
        return safe(function()
            Remote.fire(cap.remote, Remote.HASH, cap.sessionKey, token,
                        0.5, curveCFrame, SB.screen, SB.mouseLoc, false)
        end)
    end
    local ok = withParryMutex(doFire)
    if ok then
        ParryState.markFired()
        Allusive.parry.hits = Allusive.parry.hits + 1
        Allusive.parry.lastSuccess = tick()
        Stats2.push("parry")
        SB.fired += 1
    else
        Allusive.parry.fails = Allusive.parry.fails + 1
        Stats2.push("error")
    end
    return ok
end

function BallHelper.parry_keypress()
    if Parry.keyFn then safe(Parry.keyFn) end
end

