-- IMMORTAL MODULE v4.1 (high-frequency, anti-reconciliation)
--   Two engines, mutually exclusive (One Immortal):
--     * EclipseImmortal — __index hook spoofs HRP/Head CFrame reads
--     * Semi Immortal  — physical CFrame desync on RenderStepped
--   Smart Desync v3 classifies inbound balls and only spoofs when threatened.
-- =========================================================================

local Immortal = {}
Immortal.__index = Immortal

Immortal.immortalEnabled = false
Immortal.desyncActive = false
Immortal.spoofing = false
Immortal.hookInstalled = false
Immortal.pose = { cframe = nil, velocity = nil }
Immortal.spoofCount = 0
Immortal.beatsThisFrame = 0
Immortal.frameBudgetMs = 4
Immortal.eclipseConn = nil

local IMMORTAL_CFG_FILE = "Seraphim/immortal.json"
Immortal.cfg = {
    -- EclipseImmortal
    angle = 72, height = 15, depth = -8, squareRadius = 10,
    speedBypass = true,
    -- Semi Immortal — HYPER TUNED
    oscRadius = 55, oscHeight = 15, velocitySpike = 6000,
    renderSteppedMode = true,
    beatsPerFrame = 2,
    spoofPhaseJitter = true,
    velocityScale = true,
    networkClaimStride = 1,
    physicsPause = true,
    microJitter = true,
    predictiveVelocity = true,
    -- Smart Desync
    smart = false,
    sweepRange = 300, slowCap = 60, fastFloor = 150, lead = 6,
    holdSlow = 8, holdMed = 5, holdFast = 4,
    turnThreshold = 20, curveBoost = 3, missBoost = 4,
}
local cfg = Immortal.cfg
local CLASS_PROFILE = {
    SLOW   = { rng = 1.8, lead = 2.0 },
    MEDIUM = { rng = 1.0, lead = 1.0 },
    FAST   = { rng = 0.8, lead = 1.5 },
    CURVE  = { rng = 1.4 },
}

local function loadImmortalCfg()
    safe(function()
        if isfile and isfile(IMMORTAL_CFG_FILE) then
            local d = HttpService:JSONDecode(readfile(IMMORTAL_CFG_FILE))
            for k, v in pairs(d) do
                if cfg[k] ~= nil and type(v) == type(cfg[k]) then cfg[k] = v end
            end
            log("immortal config loaded")
        end
    end)
end
local function saveImmortalCfg()
    safe(function()
        if writefile then
            local ok = pcall(function() if makefolder and not isfolder("Seraphim") then makefolder("Seraphim") end end)
            writefile(IMMORTAL_CFG_FILE, HttpService:JSONEncode(cfg))
        end
    end)
end
loadImmortalCfg()

-- ====================== PHASE JITTER =====================================
local phaseRng = Random.new(math.floor(os.clock() * 1e6) % 2^31)
local function jitteredPhase(base)
    if not cfg.spoofPhaseJitter then return base end
    local j = phaseRng:NextNumber(-0.08, 0.08)
    return base * (1 + j)
end

-- ====================== ONE IMMORTAL =====================================
function Immortal.enableEclipseImmortal(state)
    if state and Immortal.desyncActive then
        Immortal.stopDesync()
        pcall(function()
            if Window and Window.Notify then
                Window:Notify({Title = "Immortal", Text = "Semi Immortal auto-stopped — one at a time", Duration = 3})
            end
        end)
    end
    Immortal.immortalEnabled = state
    if state then Immortal.installHook() end
end

function Immortal.enableDesync(state)
    if state and Immortal.immortalEnabled then
        Immortal.enableEclipseImmortal(false)
        if Immortal.ui and Immortal.ui.eclipseToggle then
            pcall(function() Immortal.ui.eclipseToggle:SetValue(false) end)
        end
        pcall(function()
            if Window and Window.Notify then
                Window:Notify({Title = "Immortal", Text = "EclipseImmortal auto-disabled — one at a time", Duration = 3})
            end
        end)
    end
    Immortal.desyncActive = state
    if state then Immortal.startDesyncLoops()
    else Immortal.stopDesync() end
end

-- ====================== ECLIPSE IMMORTAL (hook) ==========================
function Immortal.installHook()
    if Immortal.hookInstalled then return end
    local hookFn = hookmetamethod
    if not hookFn then return end
    local ok = pcall(function()
        local oldIndex
        oldIndex = hookFn(game, "__index", newcclosure(function(self, key)
            if Immortal.immortalEnabled and not checkcaller() then
                local char = LocalPlayer.Character
                if char then
                    local hrp = char:FindFirstChild("HumanoidRootPart")
                    local head = char:FindFirstChild("Head")
                    if key == "CFrame" then
                        if self == hrp and Immortal.pose.cframe then
                            return Immortal.pose.cframe
                        elseif self == head and Immortal.pose.cframe and hrp then
                            return Immortal.pose.cframe
                                + Vector3.new(0, hrp.Size.Y / 2 + 0.5, 0)
                        end
                    end
                    if (key == "AssemblyLinearVelocity" or key == "Velocity") and self == hrp then
                        if Immortal.pose.velocity then
                            return Immortal.pose.velocity
                        end
                    end
                end
            end
            return oldIndex(self, key)
        end))
    end)
    Immortal.hookInstalled = ok
    if ok then log("EclipseImmortal hook installed") end
end

local function eclipseBeat()
    if not Immortal.immortalEnabled then return end
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    Immortal.pose.cframe = hrp.CFrame
    Immortal.pose.velocity = hrp.AssemblyLinearVelocity

    local t = tick()
    local a = t * math.pi * 2 * cfg.angle / 5
    local cycle = math.floor(t * 29) % 2
    local yOff = (cycle == 0) and cfg.depth or cfg.height
    local offset = Vector3.new(
        math.cos(a) * cfg.squareRadius,
        yOff,
        math.sin(a) * cfg.squareRadius
    )
    hrp.CFrame = Immortal.pose.cframe + offset
    hrp.AssemblyLinearVelocity = Vector3.zero

    RunService.RenderStepped:Wait()
    if hrp.Parent then
        hrp.CFrame = Immortal.pose.cframe
        hrp.AssemblyLinearVelocity = Immortal.pose.velocity
    end
end

function Immortal.startEclipseImmortal()
    if Immortal.eclipseConn then return end
    if cfg.speedBypass then
        pcall(function() setfflag("S2PhysicsSenderRate", "1333335") end)
    end
    Immortal.eclipseConn = RunService.Heartbeat:Connect(eclipseBeat)
end

function Immortal.stopEclipseImmortal()
    if Immortal.eclipseConn then Immortal.eclipseConn:Disconnect(); Immortal.eclipseConn = nil end
    if Immortal.pose.cframe then
        pcall(function()
            local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                hrp.CFrame = Immortal.pose.cframe
                hrp.AssemblyLinearVelocity = Immortal.pose.velocity or Vector3.zero
            end
        end)
    end
    Immortal.pose.cframe = nil
    Immortal.pose.velocity = nil
    Immortal.immortalEnabled = false
end

-- ====================== SEMI IMMORTAL (high-freq desync) =================
local desyncConns = {}
local ballMem = setmetatable({}, { __mode = "k" })
local smartUntil = 0
local threatNow = false
local nearestDist = nil
local lastClass = "-"

local function desyncStop()
    local wasSpoofing = Immortal.spoofing
    Immortal.spoofing = false
    Immortal.desyncActive = false
    for _, c in ipairs(desyncConns) do pcall(function() c:Disconnect() end) end
    desyncConns = {}
    if wasSpoofing and Immortal.pose.cframe then
        pcall(function()
            local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                hrp.CFrame = Immortal.pose.cframe
                hrp.AssemblyLinearVelocity = Immortal.pose.velocity or Vector3.zero
            end
        end)
    end
    Immortal.pose.cframe = nil
    Immortal.pose.velocity = nil
    smartUntil = 0
    threatNow = false
    nearestDist = nil
    ballMem = setmetatable({}, { __mode = "k" })
    lastClass = "-"
    Immortal.spoofCount = 0
    Immortal.beatsThisFrame = 0
end

local function smartScan()
    local now = os.clock()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    nearestDist = nil
    lastClass = "-"
    if next(ballMem) then
        for b, m in pairs(ballMem) do
            if now - m.t > 2 then ballMem[b] = nil end
        end
    end

    local ballsFolder = workspace:FindFirstChild("Balls")
    if not ballsFolder then
        smartUntil = math.max(smartUntil, now + cfg.holdMed)
        return
    end

    local holdBefore = smartUntil
    local myName = LocalPlayer.Name

    for _, ball in ipairs(ballsFolder:GetChildren()) do
        if not ball:GetAttribute("realBall") then continue end
        local part = ball:IsA("BasePart") and ball or ball.PrimaryPart
        if not part then continue end

        local offset = part.Position - hrp.Position
        local dist = offset.Magnitude
        if not nearestDist or dist < nearestDist then nearestDist = dist end

        local vel = part.AssemblyLinearVelocity
        local sp = vel.Magnitude
        if sp < 1 then ballMem[ball] = nil; continue end

        local cls = "MEDIUM"
        if sp < cfg.slowCap then cls = "SLOW"
        elseif sp > cfg.fastFloor then cls = "FAST" end
        local prof = CLASS_PROFILE[cls]

        local inbound = vel.Unit:Dot(-offset.Unit)

        local curve = false
        local curDir = vel.Unit
        local mem = ballMem[ball]
        if mem then
            local dt = now - mem.t
            if dt >= 0.03 and dt <= 1.5 then
                local turn = math.acos(math.clamp(mem.dir:Dot(curDir), -1, 1)) / dt
                if turn >= math.rad(cfg.turnThreshold) and dist <= cfg.sweepRange * 10 then
                    curve = true
                end
            end
        end
        ballMem[ball] = { dir = curDir, t = now }

        local clsRange = cfg.sweepRange * prof.rng * (curve and CLASS_PROFILE.CURVE.rng or 1)
        local clsLead = cfg.lead * prof.lead
        local clsHold = cls == "SLOW" and cfg.holdSlow
                     or cls == "FAST" and cfg.holdFast
                     or cfg.holdMed
        if curve then clsHold = clsHold + cfg.curveBoost end
        local miss = dist <= clsRange and inbound > 0
        if miss then clsHold = clsHold + cfg.missBoost end

        local trip = false
        if dist <= clsRange then trip = true end
        if inbound > 0.2 and dist / sp <= clsLead then trip = true end
        if curve and dist <= cfg.sweepRange * 3 then trip = true end
        if ball:GetAttribute("target") == myName then trip = true end

        if trip then
            smartUntil = math.max(smartUntil, now + clsHold)
            lastClass = cls
                .. (curve and "-CURVE" or "")
                .. (miss and "+MISS" or "")
        end
    end
    threatNow = smartUntil > holdBefore
end

local lastNetworkClaim = 0
local function oneSpoofBeat()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local t0 = os.clock()
    Immortal.pose.cframe = hrp.CFrame
    Immortal.pose.velocity = hrp.AssemblyLinearVelocity

    if cfg.networkClaimStride > 0
       and (Immortal.spoofCount % cfg.networkClaimStride) == 0 then
        pcall(function() hrp:SetNetworkOwner(LocalPlayer) end)
    end

    local t = tick()
    local phase = jitteredPhase(t)
    local hOsc = math.sin(phase * 60) * cfg.oscRadius
    local vOsc = math.sin(phase * 25) * cfg.oscHeight

    local microX, microY, microZ = 0, 0, 0
    if cfg.microJitter then
        microX = phaseRng:NextNumber(-0.5, 0.5)
        microY = phaseRng:NextNumber(-0.2, 0.2)
        microZ = phaseRng:NextNumber(-0.5, 0.5)
    end

    local offset = Vector3.new(hOsc + microX, vOsc + microY, microZ)
    local rotAmp = 20
    local spoofed = Immortal.pose.cframe
        * CFrame.new(offset)
        * CFrame.Angles(
            math.rad(phaseRng:NextNumber(-rotAmp, rotAmp)),
            math.rad(phaseRng:NextNumber(-rotAmp, rotAmp)),
            math.rad(phaseRng:NextNumber(-rotAmp, rotAmp)))

    Immortal.spoofing = true
    Immortal.spoofCount = Immortal.spoofCount + 1
    hrp.CFrame = spoofed

    if cfg.physicsPause and cfg.predictiveVelocity then
        local look = hrp.CFrame.LookVector
        local nudge = (cfg.velocityScale and 1 + cfg.velocitySpike / 10000 or 1)
        hrp.AssemblyLinearVelocity = look * (2 * nudge)
    elseif cfg.physicsPause then
        hrp.AssemblyLinearVelocity = Vector3.zero
    elseif cfg.velocityScale then
        local v = Immortal.pose.velocity
        local mag = v.Magnitude
        local scaled = (mag > 0) and (v / mag) * cfg.velocitySpike or Vector3.zero
        hrp.AssemblyLinearVelocity = scaled
    else
        hrp.AssemblyLinearVelocity = Immortal.pose.velocity
            + Vector3.new(
                math.cos(t * 8) * cfg.velocitySpike,
                math.cos(t * 8) * cfg.velocitySpike,
                0)
    end

    task.wait()

    if hrp.Parent then
        hrp.CFrame = Immortal.pose.cframe
        hrp.AssemblyLinearVelocity = Immortal.pose.velocity or Vector3.zero
    end
    Immortal.spoofing = false

    local elapsed = (os.clock() - t0) * 1000
    if elapsed > Immortal.frameBudgetMs then
        Immortal.beatsThisFrame = 0
    end
end

function Immortal.startDesyncLoops()
    if #desyncConns > 0 then return end

    desyncConns[#desyncConns + 1] = RunService.Stepped:Connect(function()
        if not Immortal.desyncActive then return end
        if cfg.networkClaimStride > 0 then return end
        local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if hrp then pcall(function() hrp:SetNetworkOwner(LocalPlayer) end) end
    end)

    local scanAcc = 0
    desyncConns[#desyncConns + 1] = RunService.Heartbeat:Connect(function(dt)
        if not Immortal.desyncActive then return end
        if not cfg.smart then return end
        scanAcc = scanAcc + dt
        if scanAcc < 0.033 then return end
        scanAcc = 0
        smartScan()
    end)

    local beatDriver = cfg.renderSteppedMode and RunService.RenderStepped or RunService.Heartbeat
    desyncConns[#desyncConns + 1] = beatDriver:Connect(function()
        if not Immortal.desyncActive then
            Immortal.spoofing = false
            return
        end

        if cfg.smart and os.clock() >= smartUntil then
            Immortal.spoofing = false
            return
        end

        local beats = math.max(1, math.min(cfg.beatsPerFrame, 4))
        Immortal.beatsThisFrame = 0
        for _ = 1, beats do
            if Immortal.beatsThisFrame >= beats then break end
            Immortal.beatsThisFrame = Immortal.beatsThisFrame + 1
            oneSpoofBeat()
            if not Immortal.desyncActive then break end
        end
    end)

    log("Semi Immortal active (%s, %dx/frame)",
        cfg.renderSteppedMode and "RenderStepped" or "Heartbeat",
        cfg.beatsPerFrame)
end

function Immortal.stopDesync()
    desyncStop()
    pcall(function()
        if Window and Window.Notify then
            Window:Notify({Title = "Immortal", Text = "Semi Immortal stopped", Duration = 3})
        end
    end)
end

-- ====================== CLEANUP =========================================
local _oldUnload = getgenv().SeraphimUnload or function() end
getgenv().SeraphimUnload = function()
    Immortal.stopEclipseImmortal()
    Immortal.stopDesync()
    AutoParry.stop()
    Triggerbot.enable(false)
    if ManualSpam.active then ManualSpam.active = false end
    Macro.enabled = false
    for _, c in ipairs(BallRegistry.conns) do
        pcall(function() c:Disconnect() end)
    end
    pcall(_oldUnload)
end

LocalPlayer.OnTeleport:Connect(function()
    pcall(getgenv().SeraphimUnload)
end)

--[[
    ⚠️  DO NOT RUN YET — paste Chunk 5 immediately below this line.
    Chunk 4 ends here. Chunk 5 begins with "NeverLose-styled UI".
]]-- =========================================================================
-- NEVERLOSE-STYLED UI (AngeliUI API-compatible)
--   Same public methods as AngeliUI so every widget call below is identical.
--   Visual identity mimics NeverLose: near-black bg, blue accent, thin
--   strokes, 4px corners, watermark/indicator/logger/notifications.
-- =========================================================================
local AngeliUI
do
    local TweenService = TweenServiceX
    local UIS = UserInputServiceX
    local RS = RunService
    local LP = LocalPlayer
    local isMobile = UIS.TouchEnabled and not UIS.MouseEnabled

    local HAS_CANVASGROUP = pcall(function() return Instance.new("CanvasGroup") end)
    local HAS_UISCALE    = pcall(function() return Instance.new("UIScale") end)

    local function makeTextContainer()
        if HAS_CANVASGROUP then return Instance.new("CanvasGroup") end
        local f = Instance.new("Frame"); f.BackgroundTransparency = 1; return f
    end

    -- NeverLose theme
    local Theme = {
        Background    = Color3.fromRGB(9, 10, 15),
        Group         = Color3.fromRGB(12, 14, 20),
        GroupStroke   = Color3.fromRGB(26, 29, 38),
        Control       = Color3.fromRGB(18, 21, 29),
        ControlHover  = Color3.fromRGB(24, 28, 38),
        Divider       = Color3.fromRGB(20, 23, 31),
        Text          = Color3.fromRGB(232, 235, 242),
        TextDim       = Color3.fromRGB(120, 128, 145),
        TextSoft      = Color3.fromRGB(178, 185, 200),
        HeaderText    = Color3.fromRGB(96, 104, 120),
        TabSelected   = Color3.fromRGB(15, 18, 26),
        PillOff       = Color3.fromRGB(40, 45, 58),
        KnobOff       = Color3.fromRGB(74, 87, 97),
        PillOn        = Color3.fromRGB(61, 133, 224),
        KnobOn        = Color3.fromRGB(255, 255, 255),
        SliderTrack   = Color3.fromRGB(24, 28, 38),
        SliderFill    = Color3.fromRGB(61, 133, 224),
        Accent        = Color3.fromRGB(61, 133, 224),
        AccentDim     = Color3.fromRGB(27, 141, 240),
    }

    local Icons = {
        skull = {16898613777, 49, 869}, user = {16898613869, 661, 869},
        ["eye-off"] = {16898613353, 820, 514}, list = {16898613509, 869, 808},
        save = {16898613699, 918, 453}, ["book-open"] = {16898612819, 820, 355},
        ["chevrons-up-down"] = {16898612819, 918, 759}, database = {16898613044, 710, 869},
        eye = {16898613353, 820, 514},
    }

    local TF = TweenInfo.new(0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local TM = TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local TT = TweenInfo.new(0.22, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)

    local function New(c, p, ch)
        local i = Instance.new(c)
        for k, v in pairs(p or {}) do if k ~= "Parent" then pcall(function() i[k] = v end) end end
        for _, x in ipairs(ch or {}) do x.Parent = i end
        if p and p.Parent ~= nil then i.Parent = p.Parent end
        return i
    end
    local function Tw(o, i, p) TweenService:Create(o, i or TF, p):Play() end
    local function Cn(p, r) return New("UICorner", {CornerRadius = UDim.new(0, r), Parent = p}) end
    local function St(p, c, t) return New("UIStroke", {Color = c or Theme.GroupStroke, Transparency = t or 0, Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = p}) end
    local function Pd(p, a, b, c, d) return New("UIPadding", {PaddingTop = UDim.new(0, a or 0), PaddingBottom = UDim.new(0, b or 0), PaddingLeft = UDim.new(0, c or 0), PaddingRight = UDim.new(0, d or 0), Parent = p}) end
    local function Rnd(n, d) local m = 10 ^ (d or 0); return math.floor(n * m + 0.5) / m end

    local function MI(p, ic, s, c)
        local a = ic and Icons[ic]
        if a then
            return New("ImageLabel", {Size = UDim2.fromOffset(s, s), BackgroundTransparency = 1, Image = "rbxassetid://" .. a[1], ImageRectSize = Vector2.new(48, 48), ImageRectOffset = Vector2.new(a[2], a[3]), ImageColor3 = c, ScaleType = Enum.ScaleType.Stretch, Parent = p})
        end
        return New("Frame", {Size = UDim2.fromOffset(4, 4), BackgroundColor3 = c, BorderSizePixel = 0, Parent = p})
    end

    local Lib = {}

    -- ====================== WATERMARK ====================================
    local function MakeWatermark(parent)
        local gui = New("ScreenGui", { Name = "SeraphimNL_Watermark", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 998, Parent = parent })
        local frame = New("Frame", {
            Name = "Root", AnchorPoint = Vector2.new(1, 0),
            Position = UDim2.new(1, -14, 0, 14),
            Size = UDim2.fromOffset(260, 26),
            BackgroundColor3 = Theme.Group, BackgroundTransparency = 0.05,
            BorderSizePixel = 0, Parent = gui,
        })
        Cn(frame, 4); St(frame, Theme.Accent, 0.55)
        New("UIListLayout", {
            FillDirection = Enum.FillDirection.Horizontal,
            HorizontalAlignment = Enum.HorizontalAlignment.Right,
            VerticalAlignment = Enum.VerticalAlignment.Center,
            SortOrder = Enum.SortOrder.LayoutOrder,
            Padding = UDim.new(0, 6), Parent = frame,
        })
        Pd(frame, 0, 0, 8, 8)
        New("TextLabel", {
            LayoutOrder = 99, Size = UDim2.fromOffset(84, 26),
            BackgroundTransparency = 1, Text = "SERAPHIM",
            Font = Enum.Font.GothamBold, TextSize = 11,
            TextColor3 = Theme.Accent, TextXAlignment = Enum.TextXAlignment.Left,
            Parent = frame,
        })
        local Wm = { frame = frame, gui = gui, order = 0 }
        function Wm:AddBlock(icon, text)
            self.order += 1
            local block = New("Frame", {
                LayoutOrder = self.order, Size = UDim2.fromOffset(56, 22),
                BackgroundColor3 = Theme.Control, BackgroundTransparency = 0.4,
                BorderSizePixel = 0, Parent = frame,
            })
            Cn(block, 3); St(block, Theme.GroupStroke, 0.5)
            local ic = MI(block, icon or "list", 11, Theme.Accent)
            ic.AnchorPoint = Vector2.new(0, 0.5); ic.Position = UDim2.new(0, 5, 0.5, 0)
            local lbl = New("TextLabel", {
                Position = UDim2.new(0, 20, 0, 0), Size = UDim2.new(1, -22, 1, 0),
                BackgroundTransparency = 1, Text = text or "—",
                Font = Enum.Font.GothamBold, TextSize = 10, TextColor3 = Theme.Text,
                TextXAlignment = Enum.TextXAlignment.Left, Parent = block,
            })
            local function setText(t)
                lbl.Text = t
                local w = math.clamp(#tostring(t) * 6 + 28, 46, 120)
                Tw(block, TF, { Size = UDim2.fromOffset(w, 22) })
            end
            return {
                SetText = setText,
                SetColor = function(c) ic.ImageColor3 = c end,
                Input = function(cb)
                    local btn = New("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", Parent = block })
                    btn.MouseButton1Click:Connect(cb)
                end,
            }
        end
        function Wm:SetVisible(v) frame.Visible = v end
        -- Drag
        local dragging, dragStart, startPos
        frame.InputBegan:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
                dragging = true; dragStart = inp.Position; startPos = frame.Position
            end
        end)
        UIS.InputChanged:Connect(function(inp)
            if dragging and (inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch) then
                local d = inp.Position - dragStart
                frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
            end
        end)
        UIS.InputEnded:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end)
        return Wm
    end

    -- ====================== INDICATOR ====================================
    local function MakeIndicator(parent)
        local gui = New("ScreenGui", { Name = "SeraphimNL_Indicator", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 998, Parent = parent })
        local frame = New("Frame", {
            AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -14, 1, -14),
            Size = UDim2.fromOffset(150, 26), BackgroundColor3 = Theme.Group,
            BackgroundTransparency = 0.05, BorderSizePixel = 0, Visible = false, Parent = gui,
        })
        Cn(frame, 4); St(frame, Theme.Accent, 0.55)
        local ic = MI(frame, "skull", 12, Theme.Accent)
        ic.AnchorPoint = Vector2.new(0, 0.5); ic.Position = UDim2.new(0, 8, 0.5, 0)
        local dot = New("Frame", {
            AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0),
            Size = UDim2.fromOffset(8, 8),
            BackgroundColor3 = Color3.fromRGB(120, 255, 120),
            BorderSizePixel = 0, Parent = frame,
        })
        Cn(dot, 4)
        local lbl = New("TextLabel", {
            Position = UDim2.new(0, 26, 0, 0), Size = UDim2.new(1, -42, 1, 0),
            BackgroundTransparency = 1, Text = "IND",
            Font = Enum.Font.GothamBold, TextSize = 11, TextColor3 = Theme.Text,
            TextXAlignment = Enum.TextXAlignment.Left, Parent = frame,
        })
        local Ind = { frame = frame }
        function Ind:SetText(t) lbl.Text = tostring(t) end
        function Ind:SetColor(c)
            if typeof(c) == "string" then
                local colors = { Red = Color3.fromRGB(255, 90, 90), Green = Color3.fromRGB(120, 255, 120), Blue = Theme.Accent, White = Theme.Text }
                c = colors[c] or Theme.Accent
            end
            lbl.TextColor3 = c; dot.BackgroundColor3 = c
        end
        function Ind:SetRender(v) frame.Visible = v end
        return Ind
    end

    -- ====================== LOGGER =======================================
    local function MakeLogger(parent)
        local gui = New("ScreenGui", { Name = "SeraphimNL_Logger", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 998, Parent = parent })
        local frame = New("Frame", {
            AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 14, 1, -14),
            Size = UDim2.fromOffset(300, 170), BackgroundColor3 = Theme.Group,
            BackgroundTransparency = 0.08, BorderSizePixel = 0, Parent = gui,
        })
        Cn(frame, 4); St(frame, Theme.GroupStroke, 0.4)
        New("TextLabel", {
            Size = UDim2.new(1, 0, 0, 22), BackgroundTransparency = 1,
            Text = "  LOGGER", Font = Enum.Font.GothamBold, TextSize = 10,
            TextColor3 = Theme.HeaderText, TextXAlignment = Enum.TextXAlignment.Left,
            Parent = frame,
        })
        New("Frame", {
            Position = UDim2.new(0, 0, 0, 22), Size = UDim2.new(1, 0, 0, 1),
            BackgroundColor3 = Theme.Divider, BorderSizePixel = 0, Parent = frame,
        })
        local scroll = New("ScrollingFrame", {
            Position = UDim2.new(0, 0, 0, 23), Size = UDim2.new(1, 0, 1, -23),
            BackgroundTransparency = 1, ScrollBarThickness = 2,
            ScrollBarImageColor3 = Theme.Accent,
            CanvasSize = UDim2.new(0, 0, 0, 0),
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            ScrollingDirection = Enum.ScrollingDirection.Y,
            BorderSizePixel = 0, Parent = frame,
        })
        Pd(scroll, 8, 8, 8, 8)
        New("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder, Parent = scroll })
        local order = 0
        local Lg = {}
        function Lg:New(icon, text, duration)
            order += 1
            local row = New("Frame", {
                LayoutOrder = order, Size = UDim2.new(1, 0, 0, 0),
                AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Parent = scroll,
            })
            local ic = MI(row, icon or "list", 10, Theme.Accent)
            ic.Position = UDim2.new(0, 0, 0, 3)
            local time = os.date("%H:%M:%S")
            New("TextLabel", {
                Position = UDim2.new(0, 18, 0, 0), Size = UDim2.new(1, -18, 0, 0),
                AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1,
                Text = string.format("[%s] %s", time, tostring(text)),
                Font = Enum.Font.Gotham, TextSize = 11, TextColor3 = Theme.TextSoft,
                TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true, Parent = row,
            })
            task.delay(duration or 8, function()
                if row and row.Parent then
                    Tw(row, TM, { BackgroundTransparency = 1 })
                    task.delay(0.3, function() if row and row.Parent then row:Destroy() end end)
                end
            end)
        end
        return Lg
    end

    -- ====================== NOTIFICATIONS ================================
    local function MakeNotifications(parent)
        local gui = New("ScreenGui", { Name = "SeraphimNL_Notifications", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 999, Parent = parent })
        local holder = New("Frame", {
            AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 14),
            Size = UDim2.fromOffset(320, 400), BackgroundTransparency = 1, Parent = gui,
        })
        New("UIListLayout", {
            Padding = UDim.new(0, 6), HorizontalAlignment = Enum.HorizontalAlignment.Center,
            SortOrder = Enum.SortOrder.LayoutOrder, Parent = holder,
        })
        local order = 0
        local Nt = {}
        function Nt.new(cfg)
            cfg = cfg or {}
            order += 1
            local card = New("Frame", {
                LayoutOrder = order, Size = UDim2.fromOffset(320, 0),
                AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = Theme.Group,
                BackgroundTransparency = 0.05, BorderSizePixel = 0, Parent = holder,
            })
            Cn(card, 4); St(card, Theme.Accent, 0.5)
            local strip = New("Frame", {
                Size = UDim2.new(0, 3, 1, 0), BackgroundColor3 = Theme.Accent,
                BorderSizePixel = 0, Parent = card,
            })
            Cn(strip, 4)
            Pd(card, 10, 10, 14, 12)
            New("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder, Parent = card })
            New("TextLabel", {
                LayoutOrder = 1, Size = UDim2.new(1, 0, 0, 16),
                BackgroundTransparency = 1, Text = cfg.Title or "Seraphim",
                Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = Theme.Text,
                TextXAlignment = Enum.TextXAlignment.Left, Parent = card,
            })
            New("TextLabel", {
                LayoutOrder = 2, Size = UDim2.new(1, 0, 0, 0),
                AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1,
                Text = cfg.Content or "", Font = Enum.Font.Gotham,
                TextSize = 11, TextColor3 = Theme.TextSoft,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextWrapped = true, Parent = card,
            })
            task.delay(cfg.Duration or 3, function()
                if card and card.Parent then
                    Tw(card, TM, { BackgroundTransparency = 1 })
                    task.delay(0.25, function() if card and card.Parent then card:Destroy() end end)
                end
            end)
        end
        return Nt
    end

    -- ====================== WINDOW =======================================
    function Lib:CreateWindow(o)
        o = o or {}
        local title = o.Title or "Seraphim"
        local size
        if isMobile then
            local vp = workspace.CurrentCamera.ViewportSize
            size = UDim2.fromOffset(math.floor(vp.X * 0.95), math.floor(vp.Y * 0.92))
        else
            size = UDim2.fromOffset(680, 460)
        end

        local gp
        pcall(function() if gethui then gp = gethui() end end)
        if not gp then
            local ok, c = pcall(function() return game:GetService("CoreGui") end)
            if ok and c then
                local ok2 = pcall(function() local t = Instance.new("Folder"); t.Parent = c; t:Destroy() end)
                if ok2 then gp = c end
            end
        end
        if not gp then gp = LP:WaitForChild("PlayerGui") end
        local old = gp:FindFirstChild("AngeliUI"); if old then old:Destroy() end
        local oldNL = gp:FindFirstChild("SeraphimNL_Watermark"); if oldNL then oldNL:Destroy() end
        local oldNI = gp:FindFirstChild("SeraphimNL_Indicator"); if oldNI then oldNI:Destroy() end
        local oldNLg = gp:FindFirstChild("SeraphimNL_Logger"); if oldNLg then oldNLg:Destroy() end
        local oldNN = gp:FindFirstChild("SeraphimNL_Notifications"); if oldNN then oldNN:Destroy() end

        local Gui = New("ScreenGui", {Name = "AngeliUI", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 999, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, Parent = gp})

        local Wm = MakeWatermark(gp)
        local Ind = MakeIndicator(gp)
        local Lg = MakeLogger(gp)
        local Nt = MakeNotifications(gp)

        local mainPosY = isMobile and 0.60 or 0.5
        local Main = makeTextContainer()
        Main.Name = "Main"
        Main.AnchorPoint = Vector2.new(0.5, 0.5)
        Main.Position = UDim2.fromScale(0.5, mainPosY)
        Main.Size = size
        Main.BackgroundColor3 = Theme.Background
        Main.BorderSizePixel = 0
        if HAS_CANVASGROUP then Main.GroupTransparency = 1 end
        Main.Parent = Gui
        Cn(Main, 6); St(Main, Theme.GroupStroke, 0.35)

        local uiScale
        if HAS_UISCALE then
            uiScale = New("UIScale", {Scale = isMobile and 0.85 or 0.96, Parent = Main})
        end

        local Header = New("Frame", {Name = "Header", Size = UDim2.new(1, 0, 0, 42), BackgroundTransparency = 1, ZIndex = 5, Parent = Main})
        New("TextLabel", {
            Name = "Title", Position = UDim2.new(0, 16, 0, 0),
            Size = UDim2.new(1, -70, 1, 0), BackgroundTransparency = 1,
            Text = title, Font = Enum.Font.GothamBold, TextSize = 15,
            TextColor3 = Theme.Text, TextXAlignment = Enum.TextXAlignment.Left,
            ZIndex = 6, Parent = Header,
        })
        New("Frame", {Position = UDim2.new(0, 0, 0, 42), Size = UDim2.new(1, 0, 0, 1), BackgroundColor3 = Theme.Divider, BorderSizePixel = 0, ZIndex = 5, Parent = Main})
        New("Frame", {Position = UDim2.new(0, 160, 0, 42), Size = UDim2.new(0, 1, 1, -42), BackgroundColor3 = Theme.Divider, BorderSizePixel = 0, ZIndex = 5, Parent = Main})

        do
            local dg = false; local dgs, sp; local sx, sy = 0.5, mainPosY; local tx, ty, dx, dy
            Header.InputBegan:Connect(function(inp)
                if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
                    dg = true; dgs = inp.Position; sp = Main.Position
                    sx, sy = sp.X.Scale, sp.Y.Scale
                    tx, ty = sp.X.Offset, sp.Y.Offset; dx, dy = tx, ty
                end
            end)
            UIS.InputChanged:Connect(function(inp)
                if dg and (inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch) then
                    local d = inp.Position - dgs
                    tx = sp.X.Offset + d.X; ty = sp.Y.Offset + d.Y
                end
            end)
            UIS.InputEnded:Connect(function(inp)
                if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then dg = false end
            end)
            RS.RenderStepped:Connect(function(dt)
                if dx == nil then return end
                local ddx = tx - dx; local ddy = ty - dy
                if not dg and math.abs(ddx) < 0.5 and math.abs(ddy) < 0.5 then
                    Main.Position = UDim2.new(sx, tx, sy, ty); dx = nil; return
                end
                local s = math.min(1, dt * 14)
                dx += ddx * s; dy += ddy * s
                Main.Position = UDim2.new(sx, dx, sy, dy)
            end)
        end

        local sidebarW = isMobile and 120 or 160
        local Sidebar = New("ScrollingFrame", {Name = "Sidebar", Position = UDim2.new(0, 0, 0, 43), Size = UDim2.new(0, sidebarW, 1, -43), BackgroundTransparency = 1, ScrollBarThickness = 0, AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(0, 0, 0, 0), ScrollingDirection = Enum.ScrollingDirection.Y, BorderSizePixel = 0, ZIndex = 5, Parent = Main})
        Pd(Sidebar, 6, 6, 6, 6)
        New("UIListLayout", {Padding = UDim.new(0, 3), SortOrder = Enum.SortOrder.LayoutOrder, Parent = Sidebar})

        local Content = New("Frame", {Name = "Content", Position = UDim2.new(0, sidebarW + 1, 0, 43), Size = UDim2.new(1, -(sidebarW + 1), 1, -43), BackgroundTransparency = 1, ZIndex = 5, Parent = Main})
        Pd(Content, 8, 8, 8, 8)

        local Window = {}
        local so = 0; local ss = {}; local tabs = {}; local sms = {}
        local ct = nil; local uv = false
        local tk = Enum.KeyCode.LeftControl
        if o.ToggleKey and Enum.KeyCode[o.ToggleKey] then tk = Enum.KeyCode[o.ToggleKey] end

        function Window:SetMenuKey(newKey) tk = newKey end

        RS.Heartbeat:Connect(function(dt)
            local s = math.min(1, dt * 12)
            for sl in pairs(sms) do
                local df = sl.Target - sl.Display
                if math.abs(df) < 0.0005 then
                    sl.Display = sl.Target; sl.Render()
                    if not sl.Dragging then sms[sl] = nil end
                else
                    sl.Display = sl.Display + df * s; sl.Render()
                end
            end
        end)

        local function setV(v)
            uv = v
            Main.Visible = v
            if HAS_CANVASGROUP then Tw(Main, TM, {GroupTransparency = v and 0 or 1}) end
            if HAS_UISCALE and uiScale then
                Tw(uiScale, TM, {Scale = v and (isMobile and 0.85 or 1) or (isMobile and 0.8 or 0.96)})
            end
        end

        function Window:Notify(n)
            n = n or {}
            Nt.new({Title = n.Title or "Seraphim", Content = n.Text or "", Duration = n.Duration or 3})
        end
        function Window:Logger(icon, text, duration) Lg:New(icon or "list", text or "", duration or 8) end
        function Window:Watermark() return Wm end
        function Window:Indicator() return Ind end

        -- ====================== WIDGETS ==================================
        local function BT(p, o, op)
            local st = op.Default == true
            local rw = New("Frame", {LayoutOrder = o, Size = UDim2.new(1, 0, 0, 26), BackgroundTransparency = 1, Parent = p})
            local cl = New("TextButton", {Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, Parent = rw})
            New("TextLabel", {Size = UDim2.new(1, -50, 1, 0), BackgroundTransparency = 1, Text = op.Name, Font = Enum.Font.Gotham, TextSize = 14, TextColor3 = Theme.Text, TextXAlignment = Enum.TextXAlignment.Left, Parent = cl})
            local pl = New("Frame", {AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.fromOffset(30, 16), BackgroundColor3 = st and Theme.PillOn or Theme.PillOff, BorderSizePixel = 0, Parent = cl})
            Cn(pl, 8)
            local kn = New("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Position = st and UDim2.new(1, -8, 0.5, 0) or UDim2.new(0, 8, 0.5, 0), Size = UDim2.fromOffset(12, 12), BackgroundColor3 = st and Theme.KnobOn or Theme.KnobOff, BorderSizePixel = 0, Parent = pl})
            Cn(kn, 6)
            local e = {}
            local function ap(f)
                Tw(pl, TM, {BackgroundColor3 = st and Theme.PillOn or Theme.PillOff})
                Tw(kn, TT, {Position = st and UDim2.new(1, -8, 0.5, 0) or UDim2.new(0, 8, 0.5, 0), BackgroundColor3 = st and Theme.KnobOn or Theme.KnobOff})
                if f and op.Callback then task.spawn(op.Callback, st) end
            end
            function e:Get() return st end
            function e:Set(v, f) st = v == true; ap(f ~= false) end
            function e:SetValue(v) e:Set(v, false) end
            cl.MouseButton1Click:Connect(function() e:Set(not st) end)
            return e
        end

        local function BSl(p, o, op)
            local mn = op.Min or 0; local mx = op.Max or 100; local dc = op.Decimals or 0
            local vl = math.clamp(Rnd(op.Default or mn, dc), mn, mx)
            local sa = (vl - mn) / (mx - mn)
            local bx = New("Frame", {LayoutOrder = o, Size = UDim2.new(1, 0, 0, 42), BackgroundTransparency = 1, Parent = p})
            New("TextLabel", {Size = UDim2.new(1, -40, 0, 15), BackgroundTransparency = 1, Text = op.Name, Font = Enum.Font.Gotham, TextSize = 14, TextColor3 = Theme.TextSoft, TextXAlignment = Enum.TextXAlignment.Left, Parent = bx})
            local vll = New("TextLabel", {AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.new(0, 0, 0, 14), AutomaticSize = Enum.AutomaticSize.X, BackgroundTransparency = 1, Text = tostring(vl), Font = Enum.Font.GothamBold, TextSize = 13, TextColor3 = Theme.Accent, TextXAlignment = Enum.TextXAlignment.Right, Parent = bx})
            local hb2 = New("TextButton", {AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, -2), Size = UDim2.new(1, 0, 0, 20), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, Parent = bx})
            local tr = New("Frame", {AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 0, 0.5, 0), Size = UDim2.new(1, 0, 0, 5), BackgroundColor3 = Theme.SliderTrack, BorderSizePixel = 0, Parent = hb2})
            Cn(tr, 3)
            local fl = New("Frame", {Size = UDim2.new(sa, 0, 1, 0), BackgroundColor3 = Theme.SliderFill, BorderSizePixel = 0, Parent = tr})
            Cn(fl, 3)
            local kn = New("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(sa, 0, 0.5, 0), Size = UDim2.fromOffset(12, 12), BackgroundColor3 = Theme.SliderFill, BorderSizePixel = 0, Parent = tr})
            Cn(kn, 6)
            local sl = {Display = sa, Target = sa, Dragging = false, Fire = false, LastValue = vl}
            function sl.Render()
                local a = sl.Display
                fl.Size = UDim2.new(a, 0, 1, 0); kn.Position = UDim2.new(a, 0, 0.5, 0)
                local nv = Rnd(mn + (mx - mn) * a, dc)
                if nv ~= sl.LastValue then
                    sl.LastValue = nv; vl = nv; vll.Text = tostring(nv)
                    if sl.Fire and op.Callback then task.spawn(op.Callback, nv) end
                end
            end
            local function ks(px) Tw(kn, TF, {Size = UDim2.fromOffset(px, px)}) end
            local function stx(x)
                local r = math.clamp((x - tr.AbsolutePosition.X) / math.max(tr.AbsoluteSize.X, 1), 0, 1)
                local sn = Rnd(mn + (mx - mn) * r, dc)
                sl.Target = (sn - mn) / (mx - mn); sms[sl] = true
            end
            local function sd(inp)
                if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
                    sl.Dragging = true; sl.Fire = true; ks(15); stx(inp.Position.X)
                end
            end
            hb2.InputBegan:Connect(sd); kn.InputBegan:Connect(sd); tr.InputBegan:Connect(sd)
            UIS.InputChanged:Connect(function(inp)
                if sl.Dragging and (inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch) then stx(inp.Position.X) end
            end)
            UIS.InputEnded:Connect(function(inp)
                if sl.Dragging and (inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch) then
                    sl.Dragging = false; ks(12)
                end
            end)
            return {Get = function() return vl end, Set = function(_, v)
                local sn = math.clamp(Rnd(v, dc), mn, mx)
                sl.Target = (sn - mn) / (mx - mn); sl.Fire = true; sms[sl] = true
            end}
        end

        local function BD(p, o, op)
            local opts = op.Options or {}
            local vl = op.Default or opts[1]
            local HH = 26; local RH = 23
            local bx = New("Frame", {LayoutOrder = o, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Parent = p})
            New("UIListLayout", {Padding = UDim.new(0, 5), SortOrder = Enum.SortOrder.LayoutOrder, Parent = bx})
            New("TextLabel", {LayoutOrder = 1, Size = UDim2.new(1, 0, 0, 14), BackgroundTransparency = 1, Text = op.Name, Font = Enum.Font.Gotham, TextSize = 14, TextColor3 = Theme.TextSoft, TextXAlignment = Enum.TextXAlignment.Left, Parent = bx})
            local hd = New("Frame", {LayoutOrder = 2, Size = UDim2.new(1, 0, 0, HH), BackgroundColor3 = Theme.Control, ClipsDescendants = true, BorderSizePixel = 0, Parent = bx})
            Cn(hd, 3); St(hd, Theme.GroupStroke, 0.5)
            local hr = New("TextButton", {Size = UDim2.new(1, 0, 0, HH), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, Parent = hd})
            local vt = New("TextLabel", {Position = UDim2.new(0, 10, 0, 0), Size = UDim2.new(1, -36, 1, 0), BackgroundTransparency = 1, Text = tostring(vl), Font = Enum.Font.Gotham, TextSize = 13, TextColor3 = Theme.TextSoft, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Parent = hr})
            local cv = MI(hr, "chevrons-up-down", 14, Theme.TextDim)
            cv.AnchorPoint = Vector2.new(1, 0.5); cv.Position = UDim2.new(1, -8, 0.5, 0)
            local of = New("Frame", {Position = UDim2.new(0, 0, 0, HH), Size = UDim2.new(1, 0, 0, #opts * RH), BackgroundTransparency = 1, Parent = hd})
            New("UIListLayout", {Padding = UDim.new(0, 0), SortOrder = Enum.SortOrder.LayoutOrder, Parent = of})
            local open = false; local anim = false; local so2
            local function buildOpt(opt, i)
                local rb = New("TextButton", {LayoutOrder = i, Size = UDim2.new(1, 0, 0, RH), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, Parent = of})
                local lb = New("TextLabel", {Position = UDim2.new(0, 10, 0, 0), Size = UDim2.new(1, -20, 1, 0), BackgroundTransparency = 1, Text = tostring(opt), Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = Theme.TextDim, TextXAlignment = Enum.TextXAlignment.Left, Parent = rb})
                rb.MouseEnter:Connect(function() Tw(lb, TF, {TextColor3 = Theme.Text}) end)
                rb.MouseLeave:Connect(function() Tw(lb, TF, {TextColor3 = Theme.TextDim}) end)
                rb.MouseButton1Click:Connect(function()
                    vl = tostring(opt); vt.Text = vl; so2(false)
                    if op.Callback then task.spawn(op.Callback, vl) end
                end)
            end
            for i, opt in ipairs(opts) do buildOpt(opt, i) end
            so2 = function(s)
                if anim or s == open then return end
                open = s; anim = true
                Tw(cv, TM, {Rotation = open and 180 or 0})
                local cnt = 0
                for _, c in ipairs(of:GetChildren()) do if c:IsA("TextButton") then cnt += 1 end end
                local tg = HH + (open and (cnt * RH) or 0)
                local tw = TweenService:Create(hd, open and TM or TF, {Size = UDim2.new(1, 0, 0, tg)})
                tw.Completed:Once(function() anim = false end); tw:Play()
            end
            hr.MouseButton1Click:Connect(function() so2(not open) end)
            hr.MouseEnter:Connect(function() Tw(vt, TF, {TextColor3 = Theme.Text}) end)
            hr.MouseLeave:Connect(function() Tw(vt, TF, {TextColor3 = Theme.TextSoft}) end)
            return {Get = function() return vl end, Set = function(_, v)
                vl = tostring(v); vt.Text = vl
                if op.Callback then task.spawn(op.Callback, vl) end
            end}
        end

        local function BB(p, o, op)
            local b = New("TextButton", {LayoutOrder = o, Size = UDim2.new(1, 0, 0, 30), BackgroundColor3 = Theme.Control, Text = op.Name, Font = Enum.Font.GothamBold, TextSize = 13, TextColor3 = Theme.TextSoft, AutoButtonColor = false, BorderSizePixel = 0, Parent = p})
            Cn(b, 3); St(b, Theme.GroupStroke, 0.5)
            b.MouseEnter:Connect(function() Tw(b, TF, {BackgroundColor3 = Theme.ControlHover}) end)
            b.MouseLeave:Connect(function() Tw(b, TF, {BackgroundColor3 = Theme.Control}) end)
            b.MouseButton1Click:Connect(function() if op.Callback then task.spawn(op.Callback) end end)
            return b
        end

        local function BL(p, o, op)
            return New("TextLabel", {LayoutOrder = o, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Text = op.Text or "", Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = op.Color or Theme.TextDim, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, Parent = p})
        end

        local function BI(p, o, op)
            local bx = New("Frame", {LayoutOrder = o, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Parent = p})
            New("UIListLayout", {Padding = UDim.new(0, 5), SortOrder = Enum.SortOrder.LayoutOrder, Parent = bx})
            New("TextLabel", {LayoutOrder = 1, Size = UDim2.new(1, 0, 0, 14), BackgroundTransparency = 1, Text = op.Name, Font = Enum.Font.Gotham, TextSize = 14, TextColor3 = Theme.TextSoft, TextXAlignment = Enum.TextXAlignment.Left, Parent = bx})
            local hd = New("Frame", {LayoutOrder = 2, Size = UDim2.new(1, 0, 0, 28), BackgroundColor3 = Theme.Control, BorderSizePixel = 0, Parent = bx})
            Cn(hd, 3); St(hd, Theme.GroupStroke, 0.5)
            local tb = New("TextBox", {Position = UDim2.new(0, 10, 0, 0), Size = UDim2.new(1, -20, 1, 0), BackgroundTransparency = 1, Text = op.Default or "", PlaceholderText = op.Placeholder or "Type...", PlaceholderColor3 = Theme.TextDim, Font = Enum.Font.Gotham, TextSize = 13, TextColor3 = Theme.TextSoft, TextXAlignment = Enum.TextXAlignment.Left, ClearTextOnFocus = false, Parent = hd})
            tb.FocusLost:Connect(function() if op.Callback then task.spawn(op.Callback, tb.Text) end end)
            return {Get = function() return tb.Text end, Set = function(_, v) tb.Text = tostring(v) end}
        end

        local function CG(cf, t)
            local g = New("Frame", {Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = Theme.Group, BorderSizePixel = 0, Parent = cf})
            Cn(g, 4); St(g, Theme.GroupStroke, 0.35); Pd(g, 8, 10, 10, 10)
            New("UIListLayout", {Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = g})
            New("TextLabel", {LayoutOrder = 0, Size = UDim2.new(1, 0, 0, 12), BackgroundTransparency = 1, Text = string.upper(t), Font = Enum.Font.GothamBold, TextSize = 10, TextColor3 = Theme.HeaderText, TextXAlignment = Enum.TextXAlignment.Left, Parent = g})
            local G = {}; local co = 0
            local function no() co += 1; return co end
            function G:AddToggle(o) return BT(g, no(), o) end
            function G:AddSlider(o) return BSl(g, no(), o) end
            function G:AddDropdown(o) return BD(g, no(), o) end
            function G:AddButton(o) return BB(g, no(), o) end
            function G:AddLabel(o) return BL(g, no(), o) end
            function G:AddInput(o) return BI(g, no(), o) end
            return G
        end

        local function SEL(tab)
            local prev = ct; ct = tab
            for _, tb in ipairs(tabs) do
                local s = (tb == tab)
                if s then
                    tb.Page.Visible = true
                    tb.Page.Position = UDim2.new(0, 0, 0, 0)
                    tb.Scroller.CanvasPosition = Vector2.new(0, 0)
                else tb.Page.Visible = false end
                Tw(tb.Button, TF, {BackgroundTransparency = s and 0 or 1})
                tb.NameLabel.TextColor3 = s and Theme.Text or Theme.TextDim
                if tb.IconRef and tb.IconRef:IsA("ImageLabel") then
                    Tw(tb.IconRef, TF, {ImageColor3 = s and Theme.Accent or Theme.TextDim})
                end
            end
        end

        function Window:AddTab(to)
            to = to or {}
            local sn = to.Section or "Main"
            if not ss[sn] then
                ss[sn] = true; so += 1
                New("TextLabel", {LayoutOrder = so, Size = UDim2.new(1, 0, 0, 18), BackgroundTransparency = 1, Text = string.upper(sn), Font = Enum.Font.GothamBold, TextSize = 9, TextColor3 = Theme.HeaderText, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Bottom, Parent = Sidebar})
            end
            so += 1
            local T = {}
            local b = New("TextButton", {LayoutOrder = so, Size = UDim2.new(1, 0, 0, 30), BackgroundTransparency = 1, BackgroundColor3 = Theme.TabSelected, Text = "", AutoButtonColor = false, BorderSizePixel = 0, Parent = Sidebar})
            Cn(b, 3)
            local ic2 = MI(b, to.Icon, 14, Theme.TextDim)
            ic2.AnchorPoint = Vector2.new(0, 0.5); ic2.Position = UDim2.new(0, 10, 0.5, 0)
            local nl = New("TextLabel", {Position = UDim2.new(0, 30, 0, 0), Size = UDim2.new(1, -34, 1, 0), BackgroundTransparency = 1, Text = to.Name or "Tab", Font = Enum.Font.Gotham, TextSize = 13, TextColor3 = Theme.TextDim, TextXAlignment = Enum.TextXAlignment.Left, Parent = b})
            b.MouseEnter:Connect(function() if ct ~= T then Tw(b, TF, {BackgroundTransparency = 0.6}) end end)
            b.MouseLeave:Connect(function() if ct ~= T then Tw(b, TF, {BackgroundTransparency = 1}) end end)
            local pg = New("Frame", {Name = "P_" .. (to.Name or "Tab"), Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Visible = false, BorderSizePixel = 0, Parent = Content})
            local sc = New("ScrollingFrame", {Name = "Scroller", Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, ScrollBarThickness = 3, ScrollBarImageColor3 = Theme.Accent, AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(0, 0, 0, 0), ScrollingDirection = Enum.ScrollingDirection.Y, BorderSizePixel = 0, Parent = pg})
            local hd = New("Frame", {Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Parent = sc})
            local lc, rc
            if isMobile then
                lc = New("Frame", {Name = "Col", Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Parent = hd})
                New("UIListLayout", {Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = lc})
                rc = lc
            else
                lc = New("Frame", {Name = "Left", Size = UDim2.new(0.5, -6, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Parent = hd})
                New("UIListLayout", {Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder, Parent = lc})
                rc = New("Frame", {Name = "Right", Position = UDim2.new(0.5, 6, 0, 0), Size = UDim2.new(0.5, -6, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Parent = hd})
                New("UIListLayout", {Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder, Parent = rc})
            end
            T.Page = pg; T.Scroller = sc; T.Button = b; T.NameLabel = nl; T.IconRef = ic2
            table.insert(tabs, T)
            b.MouseButton1Click:Connect(function() if ct ~= T then SEL(T) end end)
            function T:AddGroupbox(go)
                go = go or {}
                local c = (go.Column == "Right" and not isMobile) and rc or lc
                return CG(c, go.Title or "Group")
            end
            function T:Select() SEL(T) end
            if #tabs == 1 then SEL(T) end
            return T
        end

        UIS.InputBegan:Connect(function(inp, gp)
            if gp then return end
            if inp.KeyCode == tk then setV(not uv) end
        end)
        function Window:Toggle() setV(not uv) end
        function Window:Show() setV(true) end
        function Window:Hide() setV(false) end
        function Window:Destroy() Gui:Destroy(); Wm.gui:Destroy(); Ind.gui:Destroy(); Lg.gui:Destroy(); Nt.gui:Destroy() end
        Window.Main = Main
        Window.Gui = Gui
        Window.IsMobile = isMobile
        setV(true)
        return Window
    end

    AngeliUI = Lib
end

-- ====================== WINDOW + TABS ====================================
local Window = AngeliUI:CreateWindow({Title = "SERAPHIM", ToggleKey = "LeftControl"})
local isMobile = Window.IsMobile

local function Notify(t, c, d)
    pcall(function() Window:Notify({Title = t or "Seraphim", Text = c or "", Duration = d or 2}) end)
end

local Tabs = {
    Rage = Window:AddTab({Name = "Autoparry", Icon = "skull", Section = "Combat"}),
    Detection = Window:AddTab({Name = "Detection", Icon = "eye-off", Section = "Combat"}),
    Spam = Window:AddTab({Name = "Spam", Icon = "list", Section = "Combat"}),
    Player = Window:AddTab({Name = "Player", Icon = "user", Section = "Player"}),
    Visuals = Window:AddTab({Name = "Visuals", Icon = "eye-off", Section = "Visuals"}),
    Immortal = Window:AddTab({Name = "Immortal", Icon = "skull", Section = "Systems"}),
    Misc = Window:AddTab({Name = "Misc", Icon = "list", Section = "Misc"}),
    Settings = Window:AddTab({Name = "Settings", Icon = "save", Section = "Settings"}),
}

-- ====================== WATERMARK / INDICATOR / LOGGER WIRING ============
local Wm = Window:Watermark()
local Ind = Window:Indicator()

local wmPing = Wm:AddBlock("list", "0ms")
local wmParry = Wm:AddBlock("skull", "P:0")
local wmStatus = Wm:AddBlock("save", "DISARMED")

wmStatus:Input(function()
    Window:Toggle()
end)

Ind:SetRender(true)
Ind:SetText("READY")
Ind:SetColor("Blue")

task.spawn(function()
    while true do
        task.wait(1)
        safe(function() wmPing:SetText(math.floor(PingCache.get()).."ms") end)
        safe(function() wmParry:SetText("P:"..tostring(Allusive.parry.hits)) end)
        safe(function()
            if Remote.isArmed() then
                wmStatus:SetText("ARMED")
                wmStatus:SetColor(Theme.Accent)
            else
                wmStatus:SetText("DISARMED")
            end
        end)
        safe(function()
            if Config.Enabled then
                Ind:SetText("ACTIVE")
                Ind:SetColor("Green")
            else
                Ind:SetText("IDLE")
                Ind:SetColor("White")
            end
        end)
    end
end)

Window:Logger("crosshairs", "Seraphim v5 loaded — NeverLose UI", 10)

