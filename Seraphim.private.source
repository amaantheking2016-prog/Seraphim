local AB = Tabs.Settings:AddGroupbox({Title = "About", Column = "Left"})
AB:AddLabel({Text = "Seraphim v5 • NeverLose UI Edition\nAccuracy: 65 (locked)\nImmortal v4.1 (high-freq)\nAll real + training balls"})
AB:AddButton({Name = "Rejoin Game", Callback = function()
    safe(function() TeleportService:Teleport(game.PlaceId, LocalPlayer) end)
end})
AB:AddButton({Name = "Unload Seraphim", Callback = function()
    if getgenv().SeraphimUnload then safe(getgenv().SeraphimUnload) end
end})

local FF = Tabs.Settings:AddGroupbox({Title = "FFlag Tools", Column = "Right"})
local fflagFile = "Seraphim/fflags.json"
safe(function()
    if makefolder and not isfolder("Seraphim") then makefolder("Seraphim") end
end)
local function loadFFlags()
    local map = {}
    safe(function()
        if isfile and isfile(fflagFile) then
            local d = HttpService:JSONDecode(readfile(fflagFile))
            if type(d) == "table" then map = d end
        end
    end)
    return map
end
local function applyFFlag(name, value)
    name = tostring(name or ""):gsub("^%s+", ""):gsub("%s+$", "")
    if name == "" then return false, "empty name" end
    local ok, err = pcall(function()
        if setfflag then setfflag(name, tostring(value))
        elseif setfflags then setfflags(name, tostring(value))
        else error("no setfflag available") end
    end)
    if ok then
        local m = loadFFlags(); m[name] = tostring(value)
        safe(function() writefile(fflagFile, HttpService:JSONEncode(m)) end)
    end
    return ok, err
end
FF:AddInput({Name = "Set FFlag", Default = "", Placeholder = "Name=Value", Callback = function(value)
    if type(value) ~= "string" or value == "" then return end
    local name, val = value:match("^([^=]+)=(.+)$")
    if not name then Notify("FFlag", "Format: Name=Value", 3); return end
    local ok, err = applyFFlag(name, val)
    if ok then Notify("FFlag Saved", tostring(name).." = "..tostring(val), 5)
    else Notify("FFlag Failed", tostring(err), 5) end
end})

