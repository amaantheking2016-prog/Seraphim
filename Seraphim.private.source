-- ====================== PING CACHE =======================================
local PingCache = { value = 50, updatedAt = 0, ttl = CFG.pingCacheTTL }
function PingCache.get()
    local now = tick()
    if now - PingCache.updatedAt < PingCache.ttl then return PingCache.value end
    local ok, v = pcall(function() return Stats.Network.ServerStatsItem["Data Ping"]:GetValue() end)
    if ok and type(v) == "number" and v > 0 then
        PingCache.value = v
        PingCache.updatedAt = now
    end
    return PingCache.value
end

-- ====================== ADAPTIVE PING MODEL ==============================
local PingModel = { samples = {}, capacity = 48, head = 0, mean = 50, variance = 0, lastSample = 0, minInterval = 0.05 }
function PingModel.sample()
    local now = tick()
    if now - PingModel.lastSample < PingModel.minInterval then return end
    PingModel.lastSample = now
    local ok, v = pcall(function() return Stats.Network.ServerStatsItem["Data Ping"]:GetValue() end)
    if not ok or type(v) ~= "number" or v <= 0 then return end
    local i = (PingModel.head % PingModel.capacity) + 1
    PingModel.head = i
    PingModel.samples[i] = v
    local n, sum = 0, 0
    for j = 1, PingModel.capacity do
        local s = PingModel.samples[j]
        if s then n += 1; sum += s end
    end
    if n == 0 then return end
    local mean = sum / n
    local var = 0
    for j = 1, PingModel.capacity do
        local s = PingModel.samples[j]
        if s then var += (s - mean)^2 end
    end
    PingModel.mean = mean
    PingModel.variance = var / n
end
function PingModel.getBase()
    PingModel.sample()
    local sigma = math.sqrt(PingModel.variance)
    return math.clamp((PingModel.mean + sigma * 0.5) / 10, 5, 17)
end

-- ====================== REMOTE LAYER =====================================
local Remote = {
    HASH = "5455ef47-de02-4074-808c-8d82c2cd12ec",
    key = nil, fire = nil,
    captured = { remote = nil, sessionKey = nil, token = nil, args = nil },
    votes = {},
    armed = false,
    corruptStreak = 0,
    corruptionThreshold = 3,
}
do
    local HASH = Remote.HASH
    local byte, char = string.byte, string.char
    local mfloor, bxor = math.floor, bit32.bxor

    local function timestamp()
        return tostring(mfloor(workspace:GetServerTimeNow() * 100))
    end

    local function learn(token, stamp)
        if #token ~= #stamp then return false end
        for i = 1, #token do
            local v = bxor(byte(token, i), (byte(stamp, i) + i) % 256)
            local bucket = Remote.votes[i] or {}
            Remote.votes[i] = bucket
            bucket[v] = (bucket[v] or 0) + 1
        end
        local nextKey = {}
        for i = 1, #token do
            local best, highest = 0, -1
            for v, c in pairs(Remote.votes[i]) do
                if c > highest then best, highest = v, c end
            end
            nextKey[i] = best
        end
        Remote.key = nextKey
        Remote.armed = true
        Remote.corruptStreak = 0
        log("remote armed (%d bytes)", #nextKey)
        return true
    end

    function Remote.makeToken()
        if not Remote.key then return nil end
        local stamp = timestamp()
        local out = {}
        for i = 1, #stamp do
            local v = Remote.key[i] or Remote.key[#Remote.key]
            if not v then return nil end
            out[i] = char(bxor((byte(stamp, i) + i) % 256, v))
        end
        if out[1] then
            local b = byte(out[1])
            if b < 32 or b > 126 then
                Remote.corruptStreak += 1
                if Remote.corruptStreak >= Remote.corruptionThreshold then
                    Remote.key = nil
                    Remote.armed = false
                    Remote.corruptStreak = 0
                    warn(LOG_PREFIX, "token corruption — re-arm required")
                end
                return nil
            end
        end
        return table.concat(out)
    end

    local hookFn = hookfunction or hookfunc or replaceclosure
    if not hookFn then
        warn(LOG_PREFIX, "no hookfunction — remote layer disabled")
    else
        local sample = Instance.new("RemoteEvent")
        Remote.fire = hookFn(sample.FireServer, function(self, ...)
            local args = table.pack(...)
            if args[1] == HASH and type(args[3]) == "string" then
                local prev = Remote.captured.remote
                Remote.captured.remote = self
                Remote.captured.sessionKey = args[2]
                Remote.captured.token = args[3]
                Remote.captured.args = args
                if prev ~= self then
                    log("remote changed: %s -> %s", tostring(prev), tostring(self))
                end
                if not Remote.armed then
                    local learned = learn(args[3], timestamp())
                    log("captured: %s learned=%s", self:GetFullName(), tostring(learned))
                end
            end
            return Remote.fire(self, ...)
        end)
        sample:Destroy()
        log("hook installed — parry once in-game to arm")
    end
end

function Remote.isArmed()
    return Remote.armed
       and Remote.captured.remote ~= nil
       and Remote.captured.sessionKey ~= nil
       and Remote.key ~= nil
end

