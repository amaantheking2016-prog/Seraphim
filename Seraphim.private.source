-- Fracture detection (watches local character's Abilities folder)
task.spawn(function()
    while true do
        task.wait(0.2)
        safe(function()
            local char = LocalPlayer.Character
            if not char then Allusive.state.fractureActive = false; return end
            local abilities = char:FindFirstChild("Abilities")
            if not abilities then Allusive.state.fractureActive = false; return end
            local f = abilities:FindFirstChild("Fracture")
            Allusive.state.fractureActive = (f ~= nil and f.Enabled == true)
        end)
    end
end)

-- TimeHole / Slashes of Fury
safe(function()
    local pkg = ReplicatedStorage:FindFirstChild("Packages")
    local net = pkg and pkg:FindFirstChild("_Index")
    net = net and net:FindFirstChild("sleitnick_net@0.1.0")
    local netf = net and net:FindFirstChild("net")
    if not netf then return end
    local thA  = netf:FindFirstChild("RE/TimeHoleActivate")
    local thD  = netf:FindFirstChild("RE/TimeHoleDeactivate")
    local sofA = netf:FindFirstChild("RE/SlashesOfFuryActivate")
    local sofE = netf:FindFirstChild("RE/SlashesOfFuryEnd")
    local sofP = netf:FindFirstChild("RE/SlashesOfFuryParry")
    local sofC = netf:FindFirstChild("RE/SlashesOfFuryCatch")
    if thA then thA.OnClientEvent:Connect(function(p)
        if p == LocalPlayer or p == LocalPlayer.Name
        or (p and p.Name == LocalPlayer.Name) then
            Allusive.state.timeholeActive = true
        end
    end) end
    if thD then thD.OnClientEvent:Connect(function()
        Allusive.state.timeholeActive = false
    end) end
    if sofA then sofA.OnClientEvent:Connect(function(p)
        if p == LocalPlayer or p == LocalPlayer.Name
        or (p and p.Name == LocalPlayer.Name) then
            Allusive.state.slashesoffuryActive = true
            Allusive.state.slashesoffuryCount = 0
        end
    end) end
    if sofE then sofE.OnClientEvent:Connect(function()
        Allusive.state.slashesoffuryActive = false
        Allusive.state.slashesoffuryCount = 0
    end) end
    if sofP then sofP.OnClientEvent:Connect(function()
        Allusive.state.slashesoffuryCount = (Allusive.state.slashesoffuryCount or 0) + 1
    end) end
    if sofC then sofC.OnClientEvent:Connect(function()
        spawn(function()
            local maxP = 36; local d = 0.05
            while Allusive.state.slashesoffuryActive
              and (Allusive.state.slashesoffuryCount or 0) < maxP do
                if Allusive.detection.slashesoffury then
                    BallHelper.parry(); task.wait(d)
                else break end
            end
        end)
    end) end
end)

--[[
    ⚠️  DO NOT RUN YET — paste Chunk 3 immediately below this line.
    Chunk 2 ends here. Chunk 3 begins with "Fracture handler + AutoParry".
]]-- ====================== FRACTURE HANDLER =================================
local Fracture = { lastFireAt = 0, cooldown = 4.0, pending = false }
function Fracture.onDetected()
    if not Config.FractureAutoAbility then return end
    local now = tick()
    if now - Fracture.lastFireAt < Fracture.cooldown then return end
    if Fracture.pending then return end
    Fracture.pending = true
    Fracture.lastFireAt = now
    task.spawn(function()
        local ok = pcall(function()
            ReplicatedStorage.Remotes.AbilityButtonPress:Fire()
        end)
        if not ok then Fracture.pending = false; return end
        task.wait(2.432)
        pcall(function()
            local r = ReplicatedStorage:FindFirstChild("Remotes")
            local ds = r and r:FindFirstChild("DeathSlashShootActivation")
            if ds then ds:FireServer(true) end
        end)
        Fracture.pending = false
    end)
end

-- ====================== ABILITY SCHEDULER ================================
local AbilityScheduler = { currentOwner = nil, ownerUntil = 0 }
function AbilityScheduler.acquire(owner, duration)
    local now = tick()
    if AbilityScheduler.currentOwner and now < AbilityScheduler.ownerUntil then
        local pri = { timehole = 3, sof = 2, fracture = 1 }
        if (pri[owner] or 0) <= (pri[AbilityScheduler.currentOwner] or 0) then
            return false
        end
    end
    AbilityScheduler.currentOwner = owner
    AbilityScheduler.ownerUntil = now + duration
    return true
end
function AbilityScheduler.release(owner)
    if AbilityScheduler.currentOwner == owner then
        AbilityScheduler.currentOwner = nil
        AbilityScheduler.ownerUntil = 0
    end
end
function AbilityScheduler.isFree()
    return tick() >= AbilityScheduler.ownerUntil
end

-- ====================== AUTO PARRY =======================================
local AutoParry = { conn = nil, running = false }

local function evaluateBall(ball, realBall, props)
    if not ball or not ball.Parent then return end
    if not ParryState.canFire() then return end

    local zoomies = ball:FindFirstChild("zoomies")
    if not zoomies then return end

    if not ball:GetAttribute("_seraphimHooked") then
        ball:SetAttribute("_seraphimHooked", true)
        ball:GetAttributeChangedSignal("target"):Connect(function()
            if Config.RandomTarget then Target.pickRandom() end
        end)
    end

    local ballTarget = ball:GetAttribute("target")
    if ballTarget ~= LocalPlayer.Name then return end

    local char = LocalPlayer.Character
    local myPart = char and char.PrimaryPart
    if not myPart then return end

    local velocity = zoomies.VectorVelocity
    local myPos    = myPart.Position
    local distance = (myPos - ball.Position).Magnitude

    local pingBase = PingModel.getBase()

    local rawSpeed = velocity.Magnitude
    local speedAdjusted  = math.min(math.max(rawSpeed - 9.5, 0), 650)
    local speedCoef      = 2.4 + speedAdjusted * 0.002
    local scaledAg       = speedCoef * CFG.accuracyLocked
    local targetDistance = pingBase + math.max(rawSpeed / scaledAg, 9.5)

    local isCurving = BallHelper.ball_curvedFor(ball)

    if ball:FindFirstChild("AeroDynamicSlashVFX") then
        Debris:AddItem(ball.AeroDynamicSlashVFX, 0)
        props.aerodynamic_time = tick()
    end

    local tornado = Runtime:FindFirstChild("Tornado")
    if tornado then
        local tt = tornado:GetAttribute("TornadoTime") or 1
        if (tick() - props.aerodynamic_time) < tt + 0.314159 then return end
    end

    if realBall:GetAttribute("target") == LocalPlayer.Name
    and isCurving and distance > 30 then
        return
    end

    if distance > targetDistance then return end

    if Allusive.state.fractureActive and Allusive.detection.fracture then
        Fracture.onDetected()
        return
    end

    if Config.AutoParryMode == "Keypress" then
        if Parry.keyFn then safe(Parry.keyFn) end
    else
        BallHelper.parry()
    end
end

function AutoParry.start()
    if AutoParry.conn then return end
    AutoParry.running = true
    AutoParry.conn = RunService.PreSimulation:Connect(function()
        if not AutoParry.running then return end
        if not Config.Enabled then return end
        if Allusive.triggerbot.enabled then return end
        if not Remote.isArmed() then return end

        local char = LocalPlayer.Character
        if not char or not char.PrimaryPart then return end

        local props = BallHelper.ball.properties
        local realBall = BallRegistry.first()
        if not realBall then return end

        local list = BallRegistry.iterate()
        for i = 1, #list do
            if i > CFG.maxRealBalls then break end
            evaluateBall(list[i], realBall, props)
        end

        if Config.SupportTrainingBalls then
            local t = BallRegistry.iterateTraining()
            for i = 1, #t do
                evaluateBall(t[i], realBall, props)
            end
        end
    end)
end

function AutoParry.stop()
    AutoParry.running = false
    if AutoParry.conn then AutoParry.conn:Disconnect(); AutoParry.conn = nil end
    Config.Enabled = false
end

-- ====================== TRIGGERBOT =======================================
local Triggerbot = { conn = nil }
local function triggerBall(ball)
    local tb = Allusive.triggerbot
    if tb.isParrying or tb.parries > tb.maxParries then return end
    local char = LocalPlayer.Character
    if char and char.PrimaryPart and char.PrimaryPart:FindFirstChild("SingularityCape") then return end
    tb.isParrying = true
    tb.parries = tb.parries + 1
    BallHelper.parry()
    task.delay(tb.delay, function()
        if tb.parries > 0 then tb.parries = tb.parries - 1 end
    end)
    ball:GetAttributeChangedSignal("target"):Once(function() tb.isParrying = false end)
    task.delay(1, function() tb.isParrying = false end)
end
local function triggerLoop()
    local tb = Allusive.triggerbot
    if not tb.enabled then return end
    if not Remote.isArmed() then return end
    local char = LocalPlayer.Character
    if char and char.PrimaryPart and char.PrimaryPart:FindFirstChild("SingularityCape") then return end
    local balls = workspace:FindFirstChild("Balls"); if not balls then return end
    for _, ball in ipairs(balls:GetChildren()) do
        if ball:IsA("BasePart") and ball:GetAttribute("target") == LocalPlayer.Name then
            triggerBall(ball); break
        end
    end
end
function Triggerbot.enable(state)
    Allusive.triggerbot.enabled = state
    if state then
        if not Triggerbot.conn then
            Triggerbot.conn = RunService.Heartbeat:Connect(triggerLoop)
        end
    else
        if Triggerbot.conn then Triggerbot.conn:Disconnect(); Triggerbot.conn = nil end
        Allusive.triggerbot.isParrying = false
        Allusive.triggerbot.parries = 0
    end
end

-- ====================== MANUAL SPAM ======================================
local ManualSpam = {
    active = false, conn = nil, acc = 0,
    gui = nil, frame = nil, button = nil, title = nil,
}
local function stopManualLoop()
    if ManualSpam.conn then ManualSpam.conn:Disconnect(); ManualSpam.conn = nil end
    ManualSpam.acc = 0
end
local function startManualLoop()
    stopManualLoop()
    ManualSpam.conn = RunService.Heartbeat:Connect(function(dt)
        if not ManualSpam.active then stopManualLoop(); return end
        if not Remote.isArmed() then return end
        local char = LocalPlayer.Character
        if not char or char.Parent ~= workspace.Alive then return end
        ManualSpam.acc = ManualSpam.acc + (dt or 0)
        local interval
        if Config.ManualCPSEnabled then
            interval = 1 / math.clamp(Config.ManualCPS or CFG.defaultRemoteCps, 1, CFG.spamHardCapCps)
        else
            interval = 1 / math.max(1, Config.SpamCPS or CFG.defaultSpamCps)
        end
        if ManualSpam.acc < interval then return end
        ManualSpam.acc = 0
        BallHelper.parry()
    end)
end
local function destroySpamButton()
    ManualSpam.active = false
    stopManualLoop()
    if ManualSpam.gui then ManualSpam.gui:Destroy() end
    ManualSpam.gui = nil; ManualSpam.frame = nil
    ManualSpam.button = nil; ManualSpam.title = nil
end
local function createSpamButton()
    destroySpamButton()
    local gui = Instance.new("ScreenGui")
    gui.Name = "SeraphimSpamPanel"; gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = true; gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    gui.DisplayOrder = 100
    local parented = pcall(function() gui.Parent = CoreGuiX end)
    if not parented or not gui.Parent then
        gui.Parent = LocalPlayer:WaitForChild("PlayerGui")
    end
    ManualSpam.gui = gui

    local frame = Instance.new("Frame", gui)
    frame.Size = UDim2.new(0, 140, 0, 70)
    frame.Position = UDim2.new(0.4, 0, 0.5, -35)
    frame.BackgroundColor3 = Color3.fromRGB(9, 10, 15)
    frame.BorderSizePixel = 1; frame.BorderColor3 = Color3.fromRGB(26, 29, 38)
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 4)
    ManualSpam.frame = frame

    local title = Instance.new("TextLabel", frame)
    title.Size = UDim2.new(1, 0, 0, 16); title.Position = UDim2.new(0, 0, 0, 6)
    title.Text = "SERAPHIM SPAM"; title.TextColor3 = Color3.fromRGB(232, 235, 242)
    title.BackgroundTransparency = 1; title.Font = Enum.Font.GothamBold
    title.TextSize = 11; title.TextXAlignment = Enum.TextXAlignment.Center
    ManualSpam.title = title

    local btn = Instance.new("TextButton", frame)
    btn.Size = UDim2.new(0, 110, 0, 28); btn.Position = UDim2.new(0.5, -55, 0, 34)
    btn.Text = "OFF"; btn.BackgroundColor3 = Color3.fromRGB(18, 21, 29)
    btn.TextColor3 = Color3.fromRGB(232, 235, 242)
    btn.BorderSizePixel = 1; btn.BorderColor3 = Color3.fromRGB(26, 29, 38)
    btn.Font = Enum.Font.GothamBold; btn.TextSize = 12
    btn.AutoButtonColor = false
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 3)
    ManualSpam.button = btn

    local dragging, dragStart, startPos
    title.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true; dragStart = input.Position; startPos = frame.Position
        end
    end)
    title.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
            local d = input.Position - dragStart
            frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X,
                startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end)
    UserInputServiceX.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    btn.MouseButton1Click:Connect(function()
        if not Remote.isArmed() then log("Spam: parry once first"); return end
        ManualSpam.active = not ManualSpam.active
        btn.Text = ManualSpam.active and "ON" or "OFF"
        if ManualSpam.active then
            startManualLoop()
        else
            stopManualLoop()
        end
    end)
end

-- ====================== AUTO SPAM ========================================
local AutoSpam = { conn = nil, threshold = CFG.defaultParryThreshold }
function AutoSpam.enable(state)
    if AutoSpam.conn then AutoSpam.conn:Disconnect(); AutoSpam.conn = nil end
    if not state then return end
    AutoSpam.conn = RunService.PreSimulation:Connect(function()
        if not Remote.isArmed() then return end
        local char = LocalPlayer.Character
        if not char or char.Parent ~= workspace.Alive then return end
        if Allusive.state.slashesoffuryActive then return end
        local ball = BallHelper.get_ball(); if not ball then return end
        local z = ball:FindFirstChild("zoomies"); if not z then return end
        local ping = PingCache.get()
        local pingT = math.clamp(ping / 10, 1, 16)
        local speed = z.VectorVelocity.Magnitude
        local distance = LocalPlayer:DistanceFromCharacter(ball.Position)
        local target = ball:GetAttribute("target")
        local maxDist = pingT + math.min(speed / 6, 255)
        if distance > maxDist then return end
        if target == LocalPlayer.Name and distance > 30 then return end
        if distance <= maxDist and Parry.count > AutoSpam.threshold then
            BallHelper.parry()
        end
    end)
end

-- ====================== MACROS ===========================================
local Macro = {
    enabled = false, macro1 = false, macro2 = false,
    cps = CFG.defaultTurboCps, m1Cps = CFG.defaultMacroCps, m2Cps = CFG.defaultMacroCps,
    conn = nil, acc = 0, a1 = 0, a2 = 0,
}
local function macroTick(dt)
    if not Remote.isArmed() then return end
    dt = dt or 0.016
    if Macro.macro1 then
        Macro.a1 = Macro.a1 + dt
        local iv = 1 / math.min(math.max(Macro.m1Cps, 1), 200)
        if Macro.a1 >= iv then Macro.a1 = 0; BallHelper.parry() end
    end
    if Macro.macro2 then
        Macro.a2 = Macro.a2 + dt
        local iv = 1 / math.min(math.max(Macro.m2Cps, 1), 200)
        if Macro.a2 >= iv then Macro.a2 = 0; BallHelper.parry() end
    end
    if Macro.enabled then
        Macro.acc = Macro.acc + dt
        local iv = 1 / math.min(math.max(Macro.cps, 1), 200)
        if Macro.acc >= iv then Macro.acc = 0; BallHelper.parry() end
    end
end
local function startMacroLoop()
    if Macro.conn then return end
    Macro.conn = RunService.Heartbeat:Connect(macroTick)
end

-- ====================== ERROR BUDGET =====================================
task.spawn(function()
    while true do
        task.wait(1.0)
        if Config.Enabled then
            local errs = Stats2.errorRate() * CFG.errorWindowSec
            if errs >= CFG.errorBudget then
                warn(LOG_PREFIX, "error budget exceeded — disabling autoparry")
                Config.Enabled = false
                AutoParry.stop()
                pcall(function()
                    if Window and Window.Notify then
                        Window:Notify({Title = "Auto Parry", Text = "Disabled: too many errors", Duration = 4})
                    end
                end)
            end
        end
    end
end)

