local PlayerMods = {
    fovEnabled = false, fov = 70,
    wsEnabled = false, ws = 16,
    jpEnabled = false, jp = 50,
    ijEnabled = false, ijConn = nil, reapplyConn = nil,
}
local function applyPlayerMods()
    safe(function()
        workspace.CurrentCamera.FieldOfView = PlayerMods.fovEnabled and PlayerMods.fov or 70
    end)
    local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
    if hum then
        if PlayerMods.wsEnabled then hum.WalkSpeed = PlayerMods.ws end
        if PlayerMods.jpEnabled then hum.JumpPower = PlayerMods.jp end
    end
end
local function startInfiniteJump()
    if PlayerMods.ijConn then PlayerMods.ijConn:Disconnect() end
    PlayerMods.ijConn = UserInputServiceX.JumpRequest:Connect(function()
        if not PlayerMods.ijEnabled then return end
        local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
    end)
end
local function startModReapply()
    if PlayerMods.reapplyConn then PlayerMods.reapplyConn:Disconnect() end
    PlayerMods.reapplyConn = LocalPlayer.CharacterAdded:Connect(function()
        task.wait(0.5); applyPlayerMods()
    end)
end

